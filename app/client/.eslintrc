{
   "env": {
      "node": true,
      "browser": true,
      "es2021": true
   },
   "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
   },
   "extends": [
      "eslint:recommended",
      "plugin:vue/vue3-essential"
   ],
   "rules": {
      "semi": ["error", "always"],
      "no-debugger": 0,
      "vue/no-parsing-error": [2, { "invalid-first-character-of-tag-name": false }],
      // The rule flags single-word component names. It catches the project's
      // existing single-word component names (Header, Footer, Main, Sidebar,
      // ...) and the three that shadow reserved HTML tag names. Both are
      // real, but renaming ~7 components across all their call sites is out
      // of scope for a tooling-only bump.
      "vue/multi-word-component-names": 0,
      "vue/no-reserved-component-names": 0
   }
}
