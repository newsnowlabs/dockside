$authed->post( '/profiles/:name/rename' => _admin_route( sub ( $c, $User ) {
   my $args     = _get_args( $c, _query($c) );
   my $new_name = $args->{'new_name'} or die Exception->new( 'msg' => "new_name is required" );
   return $User->renameProfile( $c->stash('name'), $new_name, $args );
} ) );
$authed->any( '/profiles/:name/rename' => \&_post_only );

# getAuthCookies - the one route here that doesn't fit _admin_route's uniform
# {status,data} shape (it builds a raw Cookie-header string, appending the
# configured globalCookie if set), but keeps the same login gate and
# try/catch-via-_render_error as everything else on this bridge.
$authed->get( '/getAuthCookies' => sub ($c) {
   my $User = $c->stash('user');
   _require_login( $c, $User ) or return;
   try {
      my @cookies = $User->generate_auth_cookies( _parent_fqdn($c) );
      my ($cookie) = map { s/;.*$//; $_ } grep { /Secure;$/ } @cookies;

      if ( $CONFIG->{'globalCookie'} && $CONFIG->{'globalCookie'}{'name'} && $CONFIG->{'globalCookie'}{'secret'} ) {
         $cookie .= sprintf( "; %s=%s",
            $CONFIG->{'globalCookie'}{'name'},
            uri_escape( $CONFIG->{'globalCookie'}{'secret'} )
         );
      }

      _json( $c, 200, { 'status' => '200', 'data' => $cookie } );
   }
   catch {
      _render_error( $c, $_ );
   };
} );

# Mojolicious::Static->dispatch runs on every request, before the router - it already has a
# non-empty 'extra' map by default: a set of the framework's own bundled fallback assets
# (favicon.ico, its logo PNGs, mojo.css, the raptor/not-found images its own dev-mode error
# page uses), served automatically if nothing in 'paths' matches first. That silently
# shadowed our own favicon.ico route below - it never even ran, because static dispatch
# already returned a (Mojolicious-branded) response before the router was ever consulted.
# 'paths' is never set at all (nothing under this process's control needs bare static-file
# serving) and any __DATA__ section is already entirely ours - 'extra' was the only place
# anything not-Dockside could ever be served from, so clear it outright rather than deleting
# keys one at a time as they're noticed.
$app->static->extra( {} );

# ── Catch-all: genuinely unmatched paths only ────────────────────────────────
# Every real route is natively registered above; this is reached only for a path that
# matches none of them - an unconditional redirect to '/' regardless of method or login
# state, not a 404: a typo'd URL or a stale
# bookmark lands on the SPA shell (or the login page, if not logged in) like
# any other unrecognised in-app navigation, and lets Vue Router take it from
# there client-side, rather than a bare error page. /assets/* and /ico/* never
# reach this: their own catch-alls above claim those two prefixes first and
# answer a real 404 instead, since a caller there is loading a specific file,
# not navigating - see that section's own comment.
$routes->any( '/*whatever' => { whatever => '' } => sub ($c) {
   return _redirect( $c, 302, '/' );
} );

# Registers _reconcile_pass (defined above, see its own comment) to run once when each forked
# worker's own event loop starts, then again on the interval - both pre-fork, on the shared
# Mojo::IOLoop->singleton, so each forked worker's own copy of the reactor ticks them
# independently; the manager itself never runs the reactor past this point, so neither fires
# there.
Mojo::IOLoop->timer( 0 => \&_reconcile_pass );
Mojo::IOLoop->recurring( $CONFIG->{'appServer'}{'reconcileIntervalSeconds'} => \&_reconcile_pass );

# The drain's own reactor pacing timer, created by the first tick below and released once the
# drain returns - a worker that exits with nothing in flight never registers one at all. It
# bounds how long a single tick may block: one_tick derives its timeout from the nearest pending
# timer, and the periodic reconciler's own is up to 300s away, so with no nearer timer a quiet
# moment mid-chain (an image pull between layer reads, say) would block well past the drain's
# deadline instead of honouring it.
my $pacer;

# The seconds a shutting-down worker has before the manager kills it, or undef for a drain with
# no limit (appServer.shutdownGraceSeconds, validated in Data.pm, holds either a positive integer
# or the string 'unlimited'). Derived once here, pre-fork, and given both to App::Shutdown below
# and to Mojo::Server::Prefork at the foot of this file, so the bound a worker drains against and
# the bound the manager enforces are the same value by construction.
my $ceiling = $CONFIG->{'appServer'}{'shutdownGraceSeconds'} eq 'unlimited'
   ? undef
   : $CONFIG->{'appServer'}{'shutdownGraceSeconds'};

# Configures App::Shutdown with everything time-, reactor- and log-shaped it deliberately does
# not know about itself. Pre-fork, so every worker inherits the same configuration.
App::Shutdown::configure(
   'ceiling'     => $ceiling,
   'obligations' => sub () {
      return {
         'creates'   => [ Reservation->create_issued_tail_ids() ],
         'hooks'     => [ Reservation->hook_dispatch_in_flight_ids() ],
         'abandoned' => [ Reservation->create_abandonable_ids() ],
      };
   },
   'clock' => \&steady_time,
   'log'   => sub ($message) { flog($message) },

   # The loop's accept limit: Mojo::Server::Prefork sets it on each worker it spawns, to its own
   # 'accepts', and the loop counts down from it on every accepted connection, stopping the
   # worker gracefully at zero. A limit of 0 stops the count. App::Shutdown's hold sets and
   # restores it.
   'accept_limit' => sub (@limit) {
      return Mojo::IOLoop->singleton->max_accepts unless @limit;
      Mojo::IOLoop->singleton->max_accepts( $limit[0] );
      return;
   },

   # The drain waits synchronously, by pumping the reactor from inside the finish handler below
   # - not by registering a timer that waits after that handler returns.
   # Mojo::IOLoop::stop_gracefully stops the reactor the moment the handler returns unless an
   # accepted inbound connection is still open, and create()'s own route answers its HTTP request
   # immediately by design (the fast-ack-then-poll contract create() itself describes), so the
   # connection that started a chain has long since closed by the time shutdown begins - a timer
   # registered there would never receive a tick. one_tick keeps the chain's own I/O and timer
   # callbacks running until it settles, Prefork's own worker heartbeat included, so the manager
   # continues to see this worker as healthy while it drains rather than force-killing it as
   # unresponsive.
   #
   # The reactor is addressed directly, rather than via Mojo::IOLoop->one_tick: that wrapper
   # croaks outright when the loop is already running, which it is here (the drain runs from
   # inside stop_gracefully, itself reached from the reactor's own signal dispatch, or from the
   # end of the step that dispatch interrupted). Its body is
   # exactly this call, and Mojo::Reactor::Poll::one_tick is re-entrant by construction - it
   # keeps its own 'running' flag set for a nested call and returns after a single event - so
   # this is the supported way to pump a running reactor from within one of its callbacks.
   'tick' => sub () {
      $pacer //= Mojo::IOLoop->recurring( 1 => sub (@) { } );
      Mojo::IOLoop->singleton->reactor->one_tick;
      return;
   },
);

# The asynchronous primitives Reservation's create chain takes from this process
# (Reservation::provider): Util's timer on the shared loop, and App::Shutdown's recycling hold.
# Pre-fork, so every worker inherits the same provider.
Reservation::provider(
   'timer' => \&Util::loop_timer,
   'hold'  => \&App::Shutdown::hold,
);

# Every callback Util enters on the loop's behalf, a Docker reply's or a timer's, runs as one of
# this worker's steps, as the reconcile pass and the two routes that start work do by calling
# busy_while themselves: the whole of what a graceful stop's signal can land inside.
Util::step_wrapper( \&App::Shutdown::busy_while );

# Graceful exit handler - refuses new creates and manually-invoked hook runs (the
# /containers/create and /containers/:id/hook routes' own App::Shutdown::admit calls) and gives
# in-flight ones the chance to settle before this worker exits, rather than relying solely on
# the startup sweep/periodic reconciler: every hook run, and every create or start a chain has
# posted to Docker and not yet recorded the result of; a chain with nothing posted, in a pull,
# a lookup or a stage write, is abandoned to the restarted workers' first pass and named in the
# log. Mojo::Server::Prefork's own graceful shutdown only waits for the HTTP connection to
# close, not for either kind of chain's own work, which outlives it - this closes that gap.
# Registered once, pre-fork, on the shared singleton. on_finish sets the latch at once and runs
# the drain at once, or, when the event arrives inside one of this worker's own steps, once
# that step has completed; its latch turns away the repeat emission a second QUIT produces
# (Mojo::IOLoop::stop_gracefully emits this event on every call) and with it a second, nested
# drain waiting a second full grace period on top of the first.
Mojo::IOLoop->singleton->on( finish => sub (@) {
   App::Shutdown::on_finish( sub () {
      App::Shutdown::drain();
      Mojo::IOLoop->remove($pacer) if $pacer;
   } );
} );

flog("Listening on 127.0.0.1:$port with $workers worker(s)...");

# Startup is done; the workers about to be forked will reload config per request, where a core
# parse failure must fail that request closed rather than exit the worker (see the startup load
# above and Data::$CORE_PARSE_FAILURE_FATAL). Cleared here, before the fork, so workers inherit
# the non-fatal setting.
$Data::CORE_PARSE_FAILURE_FATAL = 0;

Mojo::Server::Prefork->new(
   listen           => ["http://127.0.0.1:$port"],
   workers          => $workers,
   # The same ceiling the exit handler's own drain waits under, deliberately: the manager kills a
   # gracefully stopping worker at this bound, and App::Shutdown stops its drain short of it by
   # its own margin, so a worker that runs out of time logs what it leaves behind and exits
   # rather than being killed mid-line. See
   # docs/adr/0007-create-restart-recovery.md's own "Graceful exit handler" section.
   graceful_timeout => App::Shutdown::graceful_timeout_for($ceiling),
)->app($app)->run;
