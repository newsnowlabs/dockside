   my $args     = _get_args( $c, _query($c) );
   my $new_name = $args->{'new_name'} or die Exception->new( 'msg' => "new_name is required" );
   return $User->renameProfile( $c->stash('name'), $new_name, $args );
} ) );
$authed->any( '/profiles/:name/rename' => \&_post_only );

# getAuthCookies - the one route here that doesn't fit _admin_route's uniform
# {status,data} shape (it builds a raw Cookie-header string, appending the
# configured globalCookie if set), but keeps the same login gate and
# try/catch-via-_render_error as everything else on this bridge.
$authed->get( '/getAuthCookies' => sub ($c) {
   my $User = $c->stash('user');
   _require_login( $c, $User ) or return;
   try {
      my @cookies = $User->generate_auth_cookies( _parent_fqdn($c) );
      my ($cookie) = map { s/;.*$//; $_ } grep { /Secure;$/ } @cookies;

      if ( $CONFIG->{'globalCookie'} && $CONFIG->{'globalCookie'}{'name'} && $CONFIG->{'globalCookie'}{'secret'} ) {
         $cookie .= sprintf( "; %s=%s",
            $CONFIG->{'globalCookie'}{'name'},
            uri_escape( $CONFIG->{'globalCookie'}{'secret'} )
         );
      }

      _json( $c, 200, { 'status' => '200', 'data' => $cookie } );
   }
   catch {
      _render_error( $c, $_ );
   };
} );

# Mojolicious::Static->dispatch runs on every request, before the router - and before
# $app->static->paths is even set below, it already has a non-empty 'extra' map: a set of the
# framework's own bundled fallback assets (favicon.ico, its logo PNGs, mojo.css, the
# raptor/not-found images its own dev-mode error page uses), served automatically if nothing
# in 'paths' matches first. That silently shadowed our own favicon.ico route below - it
# never even ran, because static dispatch already returned a (Mojolicious-branded) response
# before the router was ever consulted. 'paths' and any __DATA__ section are already entirely
# ours (docsPath below, nothing else) - 'extra' was the only place anything not-Dockside could
# ever be served from, so clear it outright rather than deleting keys one at a time as they're
# noticed.
$app->static->extra( {} );

# ── Static /docs ──────────────────────────────────────────────────────────
# nginx's own `root` directive (sites-available/default) served this directly;
# now this process must, since nginx no longer perl_requires App.pm at all post-
# cutover. Formerly reached only via the old catch-all's nginx::DECLINED branch
# (App::_handler's own sole DECLINED source); now its own route, matched by
# path like everything else. Not behind $authed - the original never gated
# /docs on login either. Mojolicious::Static::serve only matches exact files,
# not directories - unlike nginx's own implicit index/redirect behaviour, so
# both are replicated here explicitly.
$app->static->paths( [ $CONFIG->{'appServer'}{'docsPath'} ] );

sub _serve_static ($c) {
   my $path = $c->req->url->path->to_string;
   my $root = $CONFIG->{'appServer'}{'docsPath'};

   if ( -d "$root$path" ) {
      if ( $path !~ m{/$} ) {
         $c->res->headers->location("$path/");
         return $c->rendered(301);
      }
      $path .= 'index.html';
   }

   # Mojolicious::Static::serve sets $c->res->code/content directly (not via
   # render()/rendered()) - it has no idea this call is happening from inside a route
   # callback at all. Mojolicious's own request cycle only considers a request complete
   # once something calls render()/rendered() on it; skipping that call here (as an
   # earlier version of this did, only calling it in the 404 branch below) left every
   # successful static response - a 200 with the file's own bytes already attached to
   # $c->res, ready to send - never actually sent: the worker just sat there forever,
   # silently hanging every /docs/ request. Must call rendered() unconditionally here.
   $c->app->static->serve( $c, $path );
   return $c->rendered( $c->res->code || 404 );
}

$routes->any( '/docs' => \&_serve_static );
$routes->any( '/docs/*rest' => { rest => '' } => \&_serve_static );

# ── Catch-all: genuinely unmatched paths only ────────────────────────────────
# Every real route is natively registered above; this is reached only for a path that
# matches none of them - an unconditional redirect to '/' regardless of method or login
# state, not a 404: a typo'd URL or a stale
# bookmark lands on the SPA shell (or the login page, if not logged in) like
# any other unrecognised in-app navigation, and lets Vue Router take it from
# there client-side, rather than a bare error page.
$routes->any( '/*whatever' => { whatever => '' } => sub ($c) {
   return _redirect( $c, 302, '/' );
} );

# Per-worker periodic reconciler - covers a single worker dying mid-create while its siblings
# and the manager stay up (the startup sweep above only catches a whole-process restart - see
# docs/adr/0007-create-restart-recovery.md's own "Context" section). Registered once, pre-fork,
# on the shared Mojo::IOLoop->singleton - fires independently inside every forked worker. Re-loads
# reservations.json first - sibling workers/processes may have mutated it since this worker's
# own last refresh (_authenticate's own per-request Data::load() doesn't fire on a timer tick).
Mojo::IOLoop->recurring( $CONFIG->{'appServer'}{'reconcileIntervalSeconds'} => sub (@) {
   Data::load('reservations.json');
   _with_reconcile_lock( \&_reconcile_stuck_reservations );
} );

# Graceful exit handler - refuses new creates (the /containers/create route's own
# $shuttingDown check above) and gives an in-flight one a bounded chance to reach a stable
# state before this worker actually exits, rather than relying solely on the startup
# sweep/periodic reconciler above to clean up afterwards. Mojo::Server::Prefork's own graceful
# shutdown (SIGQUIT, not the SIGTERM this repo's restart matrix sends today - see that doc's
# own "What Mojo::Server::Prefork already gives you" section) only waits for the HTTP
# connection to close, not for create()'s own detached chain, which by design outlives it -
# this closes that gap. Registered once, pre-fork, on the shared singleton - confirmed live
# (Open Questions #4) that this fires exactly once per worker, not once total.
Mojo::IOLoop->singleton->on( finish => sub (@) {
   $shuttingDown = 1;
   my $deadline = steady_time() + $CONFIG->{'appServer'}{'shutdownGracePeriod'};
   my $wait;
   $wait = Mojo::IOLoop->recurring( 1 => sub (@) {
      return if Reservation->create_in_flight_count() && steady_time() < $deadline;
      Mojo::IOLoop->remove($wait);
      Mojo::IOLoop->stop;
   } );
} );

flog("Listening on 127.0.0.1:$port with $workers worker(s)...");

Mojo::Server::Prefork->new(
   listen           => ["http://127.0.0.1:$port"],
   workers          => $workers,
   # 150s, not the 120s default - comfortably above appServer.shutdownGracePeriod (90s
   # default) so the exit handler's own bounded wait never races this hard force-kill ceiling.
   # See docs/adr/0007-create-restart-recovery.md's own "Graceful exit handler" section.
   graceful_timeout => 150,
)->app($app)->run;
