#!/usr/bin/perl

# app-server
#
# Dockside's UI/API server, standalone and async (see
# docs/plans/mojolicious-app-server-split-plan.md) - no longer embedded in nginx via
# ngx_http_perl_module. nginx proxy_passes UI/API traffic to this process on loopback
# (Proxy::ui_uri); Proxy.pm itself stays embedded in nginx for access-controlled
# devtainer routing, unaffected by this split.
#
# Two calling conventions, not one rewrite:
# - The bulk of App.pm (permission checks, CRUD reads, JSON building - no I/O wait)
#   is unchanged and reached via a catch-all route that wraps the request in
#   App::NginxAdapter and calls App::handler($r, $proto) exactly as it runs under
#   real nginx today.
# - The five routes that do genuinely slow Docker/HTTP I/O (create, stop, start,
#   remove, on-demand hook-run) are native async Mojolicious routes, registered
#   ahead of the catch-all, calling the *_async siblings in Reservation.pm/User.pm
#   via docker_exec_async/call_socket_api_async - the same non-blocking primitives
#   docker-event-daemon already runs, on this process's own Mojo::IOLoop reactor.
#   They reuse App::NginxAdapter for request-side parsing only, never its buffered
#   response-side contract (status/header_out/finalize), which has no way to
#   express "hold on, I'm waiting on Docker".

use v5.36;

use App::NginxAdapter;   # before App - pre-seeds the nginx:: constants App.pm's own
                          # BEGIN block expects (see NginxAdapter's own header comment)

use Mojolicious;
use Mojo::Server::Prefork;

use Try::Tiny;

use Util qw(flog wlog sanitize_sensitive_text YYYYMMDDHHMMSS);
use Exception;
use Data qw($CONFIG $HOSTNAME $HOSTINFO);
use Containers;
use Request;
use User;
use App;   # split_args/get_args, handler - after NginxAdapter, for the constants

flog({ 'service' => 'dockside-app', 'file' => "/var/log/$ENV{'USER'}/$ENV{'USER'}.log" });
flog("Starting...");

Data::load();

my $port    = $CONFIG->{'appServer'}{'port'};
my $workers = $CONFIG->{'appServer'}{'workers'};

my $app = Mojolicious->new;
$app->max_request_size( $CONFIG->{'appServer'}{'maxRequestSize'} );

# ── Shared helpers for the five native async routes ─────────────────────────

# Authenticates the request and enforces the globalCookieRequired gate exactly as
# App::_handler does today (App.pm:363-372) - a real, configured, instance-wide
# access gate (config.json's globalCookie.name/.secret) that every other route
# still enforces via _handler, so these five must too, not just the authenticate()
# call the plan's own "Two calling conventions" section names explicitly. Returns
# $User on success. On failure, renders the response directly - matching
# _handler's own plain-text 401 shape exactly (not the JSON shape _render_error
# below produces) - and returns undef; callers must check for that and stop
# rather than proceed to dispatch.
#
# Data::load() here mirrors App::handler's own first line (App.pm:887) - each of
# Mojo::Server::Prefork's worker processes has its own independent memory (forked at
# startup, not shared), so a reservation another worker just created/mutated (e.g. via
# its own create_async, or docker-event-daemon's own writes) is otherwise invisible to
# this one until something reloads it. The catch-all path already gets this for free
# via App::handler; these five native routes bypass App::handler entirely, so they
# need their own call. Verified live: a create/stop pair against real app-server
# workers - stop landed on a different worker than the one that created the
# reservation, gave 401 "Container not found" (User::reservation's own not-found
# shape, not an auth failure) - fixed by adding this line, confirmed live.
sub _authenticate ($r, $c) {
   Data::load();

   my $protocol = lc( $r->header_in('X-Forwarded-Proto') // 'http' );
   my $User = Request->authenticate( { 'cookie' => $r->header_in('Cookie'), 'protocol' => $protocol } );

   if ( $User->authstate('globalCookieRequired') && !$User->authstate('globalCookie') ) {
      $c->res->headers->add( 'Cache-Control', 'no-store' );
      $c->render( text => "Not found!\n", status => 401 );
      return undef;
   }

   return $User;
}

# Mirrors _api_handler's own catch block (App.pm) exactly - same Exception shape,
# same sanitize_sensitive_text treatment, same 401 default - so a client sees an
# identical error response whether a request landed on the adapter path or one of
# these five native routes.
sub _render_error ($c, $err) {
   my ( $msg, $dbg, $time, $status );
   if ( ref($err) eq 'Exception' ) {
      ( $msg, $dbg, $time, $status ) = ( $err->msg(), $err->dbg(), $err->time(), $err->status() );
   }
   else {
      ( $msg, $dbg, $time ) = ( $err, $err, time() );
   }
   $status //= 401;
   ( $msg, $dbg ) = map { sanitize_sensitive_text($_) } ( $msg, $dbg );
   my $Time = YYYYMMDDHHMMSS($time);
   flog("app-server: reporting exception at '$Time': msg='$msg'; dbg='$dbg'; status='$status'");
   return $c->render(
      json   => { 'status' => "$status", 'msg' => "$msg (at $Time)", 'time' => $time },
      status => $status,
   );
}

# Every _api_handler-derived route needs the same "not logged in" handling
# _handler's own gate already provides for free today (App.pm:417-430) -
# _api_handler itself is never reached at all for a non-logged-in user, so
# every route inside it implicitly assumes a genuinely logged-in $User. Ported
# routes need this explicitly.
#
# Deliberately *not* a verbatim port of _handler's own "always redirect to /"
# behaviour: that made sense when every route rendered HTML for a browser, but
# these are genuinely JSON API endpoints now, and a 302 is a poor response to
# an AJAX/fetch caller (nothing about it is actionable - the browser doesn't
# navigate on an XHR redirect, it just... returns the redirect response). A
# clean 401 JSON is the more honest response for an API client, so pick
# between the two via content negotiation: $c->accepts('json', 'html') reads
# the client's own Accept header (Mojolicious::Types->detect, respecting
# priority order) - json (or an ambiguous/absent Accept - accepts() defaults
# to the first format listed, 'json' here) gets 401 JSON; html (a real
# browser's own top-level navigation, whose default Accept always leads with
# text/html) gets the redirect, matching today's behaviour exactly for that
# case. Verified live against the three real clients this matters for: axios
# (the Vue app's own HTTP client, unmodified) defaults to
# "application/json, text/plain, */*" -> json; the CLI sends "application/json"
# explicitly -> json; a browser navigating sends "text/html,..." -> html. No
# client-side change needed for any of them.
sub _require_login ($c, $r, $User) {
   return 1 if $User->username;
   if ( ( $c->accepts( 'json', 'html' ) // 'json' ) eq 'html' ) {
      App::redirect( $r, 302, '/' );
   }
   else {
      App::json( $r, 401, { 'status' => '401', 'msg' => 'Not logged in' } );
   }
   $r->finalize($c);
   return 0;
}

# ── The five native async routes (see the plan's "Async actions" section) ───
# Registered ahead of the catch-all so Mojolicious's router matches these
# literal paths before ever trying the wildcard (it would anyway, regardless of
# registration order, but registering them first keeps the intent readable).

my $routes = $app->routes;

# ── Auth bridge for natively-ported routes ───────────────────────────────────
# Mojolicious's own replacement for _handler's inline auth (App.pm:363-372),
# repeated identically at the top of every route today: authenticate once, per
# request, then enforce the globalCookieRequired gate - the same check
# _authenticate above already factors out for the five async routes, reused here
# rather than duplicated a third time. A false return short-circuits dispatch
# entirely for everything registered under this bridge (Mojolicious's own
# mechanism for "gate before the group", no manual status-code bookkeeping
# needed) - _authenticate has already rendered the 401 itself in that case.
#
# Deliberately does NOT reject an unauthenticated (not-logged-in) request at
# all, GET or POST - only missing/invalid globalCookie does that
# unconditionally. Everything else about login state is route-specific:
# static assets are served regardless (main.css, favicon, ico/*), main.js
# requires login, _require_login above content-negotiates a 401/redirect for
# API routes, and the SPA-shell/login route below is the only place that
# actually treats a not-logged-in POST as a login form submission - narrower
# than _handler's own current behaviour (App.pm:432-437 treats *any*
# not-logged-in POST, to any path, as a login attempt) but a real browser's
# own login form only ever POSTs back to '/' or '/container/*' in practice
# (the only two paths that ever render it) anyway, so nothing legitimate
# relies on the wider version - simpler to scope the check to where it's
# actually meaningful than to duplicate "is this secretly a login attempt?"
# reasoning into every future route registered under this bridge.
#
# Every _api_handler/_handler route ported to a native route (see
# docs/plans/mojolicious-app-server-split-plan.md's "End state" section) is
# registered under this bridge, not directly on $routes - the five async routes
# above are deliberately left as they are (their own inline _authenticate call),
# already proven correct in production; no reason to touch them just to share
# this bridge too.
my $authed = $routes->under('/' => sub ($c) {
   my $r = App::NginxAdapter->new($c);
   my $User = _authenticate( $r, $c ) or return undef;
   $c->stash( 'user' => $User );
   return 1;
} );

$routes->post('/containers/create')->to(
   cb => sub ($c) {
      $c->render_later;
      my $r = App::NginxAdapter->new($c);
      try {
         my $User = _authenticate( $r, $c ) or return;

         my $args = { %{ App::split_args( $r->request_body // '' ) }, %{ App::split_args( $r->args ) } };
         my $parentFQDN = $r->header_in('Host');
         $parentFQDN =~ s!^[^\-\.]+!!;
         $parentFQDN = '-' . $parentFQDN unless $parentFQDN =~ /^\./;
         $args->{'parentFQDN'} ||= $parentFQDN;

         $User->createContainerReservation(
            $args,
            sub ( $reservation, $err ) {
               return _render_error( $c, $err ) if $err;
               return $c->render( json => {
                  'status'      => $reservation ? '200' : '401',
                  'reservation' => $reservation,
               } );
            }
         );
      }
      catch {
         _render_error( $c, $_ );
      };
   }
);

for my $action (qw(stop start remove)) {
   $routes->post("/containers/:id/$action")->to(
      cb => sub ($c) {
         $c->render_later;
         my $r  = App::NginxAdapter->new($c);
         my $id = $c->stash('id');
         try {
            my $User = _authenticate( $r, $c ) or return;

            # Outcome deliberately ignored, matching _api_handler's own existing
            # behaviour (App.pm:591-596: "until there is better support in the
            # Vue app to display errors, there is no point in returning") - the
            # client reflects state from the fresh reservations list below
            # regardless of whether the underlying action itself succeeded.
            $User->controlContainer(
               $action, $id, {},
               sub ( $result, $err ) {
                  return $c->render( json => {
                     'status' => '200',
                     'data'   => $User->reservations( { 'client' => 1 } ),
                  } );
               }
            );
         }
         catch {
            _render_error( $c, $_ );
         };
      }
   );
}

$routes->post('/containers/:id/hook')->to(
   cb => sub ($c) {
      $c->render_later;
      my $r  = App::NginxAdapter->new($c);
      my $id = $c->stash('id');
      try {
         my $User = _authenticate( $r, $c ) or return;
         my $args = { %{ App::split_args( $r->request_body // '' ) }, %{ App::split_args( $r->args ) } };

         $User->runContainerHook(
            $id, $args,
            sub ( $result, $err ) {
               return _render_error( $c, $err ) if $err;
               return $c->render( json => { 'status' => '200', 'data' => $result } );
            }
         );
      }
      catch {
         _render_error( $c, $_ );
      };
   }
);

# ── First natively-ported routes (see the plan's "End state" section) ───────
# Mechanical ports of App.pm's own static-asset blocks (App.pm:380-402,
# 409-415, 452-458) - same paths, same files, same behaviour, registered under
# the $authed bridge above instead of App::handler's if-chain. Content-Type
# comes from Mojolicious's own extension-based detection (reply->file, via
# Mojolicious::Types) rather than the original code's explicit
# send_http_header(...) calls - verified to match for every extension used
# here except .ico, where the original used a non-standard "image/icon"
# (not an IANA-registered type) for both favicon.ico *and* apple-touch-icon.png
# alike; Mojolicious's own detection gives the correct "image/x-icon"/
# "image/png" for each respectively - a harmless, incidental correctness fix,
# not a deliberate behaviour change in its own right.
for my $file (qw(favicon.ico apple-touch-icon.png)) {
   $authed->get("/$file" => sub ($c) { $c->reply->file("$CONFIG->{'assetsPath'}/ico/$file") } );
}
$authed->get( '/ico/:file' => [ file => qr/[a-z0-9\-_]+\.png/ ] => sub ($c) {
   $c->reply->file("$CONFIG->{'assetsPath'}/ico/" . $c->stash('file'));
} );
$authed->get( '/ico/:file' => [ file => qr/[a-z0-9\-_]+\.svg/ ] => sub ($c) {
   $c->reply->file("$CONFIG->{'assetsPath'}/ico/" . $c->stash('file'));
} );

# Served pre-auth too (reachable regardless of login state, like the routes
# above - only the $authed bridge's own globalCookieRequired gate applies) so
# the also-pre-auth login page can link to it same-origin instead of an
# external CDN. main.js has no pre-auth reader, so it stays gated below with
# the rest of the authenticated app's assets.
$authed->get( '/assets/main.css' => sub ($c) {
   $c->res->headers->cache_control('public, max-age=31536000, immutable');
   $c->reply->file("$CONFIG->{'clientDistPath'}/main.css");
} );

# Gated on login (unlike main.css above) - matches the original's own
# placement, after the "not logged in" branch's own redirect-to-'/' handling.
# A not-logged-in request here hits that same fate: redirected to '/', not a
# 401 - stale cached references (e.g. after logout) should land on the login
# page like any other pre-auth page view, not error.
$authed->get( '/assets/main.js' => sub ($c) {
   my $User = $c->stash('user');
   unless ( $User->username ) {
      $c->res->headers->add( 'Cache-Control', 'no-store' );
      $c->res->headers->location('/');
      return $c->render( text => "Redirecting to / ...\n", status => 302 );
   }
   $c->res->headers->cache_control('public, max-age=31536000, immutable');
   $c->reply->file("$CONFIG->{'clientDistPath'}/main.js");
} );

# The SPA shell ('/', '/container/*', '/admin/*', '/account/*' - App.pm:460, via
# the now-shared App::render_spa_shell) and the login page/form it falls back to
# when not logged in (App.pm:417-438). No method restriction, matching the
# original block's own lack of one - a POST here while logged in (unusual, but
# not prevented today) renders the same shell a GET would.
#
# This is the one place a not-logged-in POST is treated as a login form
# submission - deliberately scoped here rather than handled bridge-wide (see
# $authed's own comment on why): these are the only paths that ever render
# the login form in the first place, so they're the only ones a browser's own
# login form ever POSTs back to.
#
# Still adapter-based (App::send_login_page/redirect/handle_login_form/
# render_spa_shell, reused verbatim, unchanged) rather than rewritten to
# render via $c directly - a verbatim port of dispatch first, matching the
# plan's own recommended approach; fully retiring the adapter from these call
# sites is its own later, focused pass once every route is ported and the
# shared response helpers can be updated once for all of them together, not
# piecemeal per route.
my $spa_shell_or_login = sub ($c) {
   my $User = $c->stash('user');
   my $r    = App::NginxAdapter->new($c);
   my $path = $c->req->url->path->to_string;

   unless ( $User->username ) {
      if ( $c->req->method eq 'POST' ) {
         my $parentFQDN = $r->header_in('Host');
         $parentFQDN =~ s!^[^\-\.]+!!;
         $parentFQDN = '-' . $parentFQDN unless $parentFQDN =~ /^\./;
         App::handle_login_form( $r, $parentFQDN ) || App::send_login_page($r);
      }
      elsif ( $path eq '/' || $path =~ m!^/container/! ) {
         App::send_login_page($r);
      }
      else {
         App::redirect( $r, 302, '/' );
      }
      return $r->finalize($c);
   }

   my $parentFQDN = $r->header_in('Host');
   $parentFQDN =~ s!^[^\-\.]+!!;
   $parentFQDN = '-' . $parentFQDN unless $parentFQDN =~ /^\./;
   App::render_spa_shell( $r, $User, $parentFQDN );
   return $r->finalize($c);
};

$authed->any( '/' => $spa_shell_or_login );
for my $prefix (qw(container admin account)) {
   $authed->any( "/$prefix" => $spa_shell_or_login );
   $authed->any( "/$prefix/*rest" => { rest => '' } => $spa_shell_or_login );
}

# ── _api_handler's own container routes (App.pm:544-642), ported verbatim ───
# Same bodies, same User.pm calls, same json()/text() rendering (still
# adapter-based - see the SPA-shell/login routes' own comment on why) - only
# the dispatch mechanism (native route vs if-chain), the explicit
# _require_login call (previously implicit via _handler's own gate - see
# _require_login's own comment), and per-route try/catch (previously one big
# try wrapping all of _api_handler's blocks together - each block is its own
# route now, so each needs its own; the catch body is _render_error, unchanged,
# giving the identical Exception-aware status/sanitize/json-or-text handling
# _api_handler's own single catch block already provides today) are new. The
# five mutating container routes (create/stop/start/remove/hook) are already
# native, above; update is POST-only exactly like those five, but stayed a
# synchronous User.pm call (updateContainerReservation was never converted to
# *_async) so it's ported here with the rest of _api_handler instead.
$authed->post( '/containers/:id/update' => sub ($c) {
   my $r    = App::NginxAdapter->new($c);
   my $User = $c->stash('user');
   _require_login( $c, $r, $User ) or return;
   try {
      my $id   = $c->stash('id');
      my $args = { %{ App::split_args( $r->request_body // '' ) }, %{ App::split_args( $r->args ) } };
      $args->{'id'} = $id if $id;

      my $reservation = $User->updateContainerReservation($args);
      App::json( $r, $reservation ? 200 : 401, { 'status' => $reservation ? '200' : '401', 'reservation' => $reservation } );
      $r->finalize($c);
   }
   catch {
      _render_error( $c, $_ );
   };
} );

$authed->get( '/containers/:id/hook/status' => sub ($c) {
   my $r    = App::NginxAdapter->new($c);
   my $User = $c->stash('user');
   _require_login( $c, $r, $User ) or return;
   try {
      my $id     = $c->stash('id');
      my $args   = App::split_args( $r->args );
      my $result = $User->runContainerHookStatus( $id, $args );
      App::json( $r, 200, { 'status' => '200', 'data' => $result } );
      $r->finalize($c);
   }
   catch {
      _render_error( $c, $_ );
   };
} );

$authed->get( '/containers/:id/logs' => sub ($c) {
   my $r    = App::NginxAdapter->new($c);
   my $User = $c->stash('user');
   _require_login( $c, $r, $User ) or return;
   try {
      my $id   = $c->stash('id');
      my $args = App::split_args( $r->args );
      my $logs = $User->controlContainer( 'getLogs', $id, $args );
      if ( ( $args->{'format'} // '' ) eq 'text' ) {
         App::text( $r, 200, join( '', @$logs ) );
      }
      else {
         App::json( $r, 200, { 'status' => '200', 'data' => $logs } );
      }
      $r->finalize($c);
   }
   catch {
      _render_error( $c, $_ );
   };
} );

$authed->get( '/containers' => sub ($c) {
   my $r    = App::NginxAdapter->new($c);
   my $User = $c->stash('user');
   _require_login( $c, $r, $User ) or return;
   try {
      my $containers = $User->reservations( { 'client' => 1 } );
      App::json( $r, 200, { 'status' => '200', 'data' => $containers } );
      $r->finalize($c);
   }
   catch {
      _render_error( $c, $_ );
   };
} );

$authed->get( '/resources' => sub ($c) {
   my $r    = App::NginxAdapter->new($c);
   my $User = $c->stash('user');
   _require_login( $c, $r, $User ) or return;
   try {
      die Exception->new( 'msg' => "You need the 'manageUsers' or 'manageProfiles' permission" )
         unless $User->has_permission('manageUsers') || $User->has_permission('manageProfiles');
      my @networks = sort { $a cmp $b } keys %{ ( Containers->containers // {} )->{$HOSTNAME // ''}{'inspect'}{'Networks'} // {} };
      my @runtimes = sort { $a cmp $b } keys %{ ( $HOSTINFO->{'docker'} // {} )->{'Runtimes'} // {} };
      my @IDEs     = @{ $HOSTINFO->{'IDEs'} // [] };
      App::json( $r, 200, {
         'status' => '200',
         'data'   => {
            'runtimes'  => \@runtimes,
            'networks'  => \@networks,
            'IDEs'      => \@IDEs,
            'authModes' => [ 'user', 'developer', 'public', 'viewer', 'owner' ],
         }
      } );
      $r->finalize($c);
   }
   catch {
      _render_error( $c, $_ );
   };
} );

# ── Static /docs (the sole nginx::DECLINED source - App.pm:375, verified) ───
# nginx's own `root` directive (sites-available/default) served this directly;
# now this process must, since nginx no longer perl_requires App.pm at all post-
# cutover. Mojolicious::Static::serve only matches exact files, not directories -
# unlike nginx's own implicit index/redirect behaviour, so both are replicated
# here explicitly.
$app->static->paths( [ $CONFIG->{'appServer'}{'docsPath'} ] );

sub _serve_static ($c) {
   my $path = $c->req->url->path->to_string;
   my $root = $CONFIG->{'appServer'}{'docsPath'};

   if ( -d "$root$path" ) {
      if ( $path !~ m{/$} ) {
         $c->res->headers->location("$path/");
         return $c->rendered(301);
      }
      $path .= 'index.html';
   }

   # Mojolicious::Static::serve sets $c->res->code/content directly (not via
   # render()/rendered()) - it has no idea this call is happening from inside a route
   # callback at all. Mojolicious's own request cycle only considers a request complete
   # once something calls render()/rendered() on it; skipping that call here (as an
   # earlier version of this did, only calling it in the 404 branch below) left every
   # successful static response - a 200 with the file's own bytes already attached to
   # $c->res, ready to send - never actually sent: the worker just sat there forever.
   # Verified live: reproduced in isolation (a scratch Mojolicious::Lite script hitting
   # exactly this), Mojolicious's own trace log names it precisely - "Nothing has been
   # rendered, expecting delayed response" - then nothing, ever, confirming this is what
   # was silently hanging every /docs/ request before this fix.
   $c->app->static->serve( $c, $path );
   return $c->rendered( $c->res->code || 404 );
}

# ── Catch-all: everything else, unchanged, via the $r-adapter + App::handler ─

$routes->any('/*whatever')->to(
   'whatever' => '',
   cb         => sub ($c) {
      my $r        = App::NginxAdapter->new($c);
      my $protocol = lc( $r->header_in('X-Forwarded-Proto') // 'http' );

      my $rc = eval { App::handler( $r, $protocol ) };

      if ( !defined $rc ) {
         flog("app-server: adapter/handler error: $@");
         return $c->render( text => 'Internal Server Error', status => 500 );
      }
      if ( $rc == nginx::DECLINED ) {
         return _serve_static($c);
      }
      if ( $rc == nginx::HTTP_BAD_REQUEST ) {
         return $c->render( text => 'Bad Request', status => 400 );
      }
      # nginx::OK
      return $r->finalize($c);
   }
);

flog("Listening on 127.0.0.1:$port with $workers worker(s)...");

Mojo::Server::Prefork->new(
   listen  => ["http://127.0.0.1:$port"],
   workers => $workers,
)->app($app)->run;
