#!/usr/bin/perl

# docker-event-daemon
#
# A daemon that keeps Dockside's container state file (containers.json) in sync with the live
# Docker engine, bridging Docker's runtime state to Dockside's own data layer so the application
# always has an up-to-date view of running containers.
#
# This script owns only the reactor wiring and process lifecycle; the daemon's actual decision
# logic lives in four library modules under app/server/lib/EventDaemon/, each `use`d below:
# - EventDaemon::ContainerSync   - container-state sync (update/_update_merge) and Docker event
#   classification (onEvent), including kicking off a container start's launch:-DAG.
# - EventDaemon::LaunchDispatch  - the launch:-DAG driver (launch:prep -> {launch:git, launch:ide,
#   lifecycle:*}). Every dispatch is a non-blocking docker_exec call, never a fork; each stage's
#   own completion callback re-scans for newly-eligible dependents, so a single launch_advance
#   call drives the whole DAG to completion on its own.
# - EventDaemon::LaunchReadiness - the mountIDE:false pre-dispatch gate (wait for the launcher
#   script to exist inside the container before kicking off the DAG at all).
# - EventDaemon::LaunchRecovery  - tracks and re-polls a stage whose completion callback will
#   never fire (this daemon restarted mid-dispatch, or lost a claim to a manual invocation).
#
# Event loop (eventHandler):
# - A persistent, non-blocking streamed GET /events (Mojo::IOLoop, via Util::call_socket_api)
#   - not a spawned `docker events` subprocess. Maps directly onto `docker events --format
#   "{{ json . }}"`'s own output: newline-delimited JSON, one event object per line - no
#   demuxing needed here, unlike exec output.
# - Runs a 0.5s recurring timer (Mojo::IOLoop->recurring) alongside the event stream, on the
#   same reactor - a long-held-open stream and a recurring timer coexist correctly on one
#   reactor without blocking each other. Each tick calls EventDaemon::ContainerSync::update on
#   its own debounce schedule, then EventDaemon::LaunchReadiness::check_pending_launches, then
#   EventDaemon::LaunchRecovery::check_launch_recovering.
#
# Debounced updates (timer tick):
# Three tiers of update frequency:
# 1. With sizes    - every ~55s, but only when no events have arrived for 5+ seconds (slow, so deferred).
# 2. After events  - within 1s of a relevant event (fast refresh).
# 3. Heartbeat     - every 15s regardless (keeps state fresh even when idle).
#
# Event handling (EventDaemon::ContainerSync::onEvent):
# Listens for specific Docker event types:
# - network connect/disconnect     -> triggers a container update.
# - container stop/create/destroy  -> triggers a container update.
# - container start                -> triggers a container-start handler, which kicks off the
#                                     launch:-DAG via EventDaemon::LaunchDispatch::launch_advance.
#
# Lifecycle:
# - Runs in an outer while(1) loop: if eventHandler crashes or the /events stream closes (Docker
#   restart, connection error, etc.), it restarts automatically after 1 second - this is ordinary,
#   expected behaviour, not tied to shutdown in any way (see $STOP_EVENT_LOOP's own comment:
#   stopping the reactor never itself harms anything in flight, so this path is never gated).
# - Handles SIGTERM/SIGINT/SIGQUIT by refusing any new DAG dispatch
#   (EventDaemon::LaunchDispatch::begin_shutdown) and asking the reactor to stop, but the outer
#   loop only actually lets the *process* exit once no non-detached hook exec is genuinely still
#   in flight - EventDaemon::LaunchDispatch::drain_complete, the one place that decision belongs
#   (see its own comment). Until then, each eventHandler cycle runs normally - new dispatch
#   refused, everything else (including servicing whatever's still in flight) unaffected - and
#   the outer loop re-checks on every iteration. No new timeout governs this wait: every
#   in-flight exec already carries its own, so the condition is guaranteed to become true on its
#   own.

use v5.36;

use JSON;

use Try::Tiny;
use File::Path;
use Time::HiRes qw(time);

use Mojo::IOLoop;

use Util qw(flog call_socket_api);
use Data qw($CONFIG);
use EventDaemon::ContainerSync qw(update onEvent);
use EventDaemon::LaunchDispatch qw(begin_shutdown drain_complete);
use EventDaemon::LaunchReadiness qw(check_pending_launches);
use EventDaemon::LaunchRecovery qw(check_launch_recovering restart_recovery_sweep);

my $SIGNAL_RECEIVED = 0;
my $STOP_EVENT_LOOP = sub { };

$SIG{'INT'} = $SIG{'QUIT'} = $SIG{'TERM'} = sub {
   # Refuse any new DAG dispatch from this point on (EventDaemon::LaunchDispatch::
   # is_shutting_down - a refused stage just stays 'pending' for the next process's own
   # restart_recovery_sweep to pick up), then ask the reactor to stop - $STOP_EVENT_LOOP is an
   # ordinary, unconditional stop (see its own comment), so this always returns control to
   # eventHandler's own caller promptly; it's the outer while(1) loop below, not this handler,
   # that decides whether it's actually safe to let the *process* exit yet.
   flog("eventHandler: Received SIGTERM; preparing to exit.");
   $SIGNAL_RECEIVED = 1;
   begin_shutdown();
   $STOP_EVENT_LOOP->();
};

# Runs the main event loop: wires up the streamed /events reader and recurring timer on
# Mojo::IOLoop's own (singleton) reactor, then blocks until the stream ends, an exception
# occurs, or a signal fires. On exit, tears down this call's own timer/stream registrations -
# necessary because Mojo::IOLoop is a singleton reused across every eventHandler() call (unlike
# the old per-call `IO::Async::Loop->new`), so a restart that didn't clean up first would
# accumulate a second, overlapping recurring timer alongside the first, each independently
# calling update() and servicing pending/recovering launches - two timers racing to service the
# same state, the same class of bug a duplicate daemon process running at once would cause.
sub eventHandler {
   flog("eventHandler: Starting...");

   my $eventCount = 0;
   my $lastSizesUpdateTime = 0;
   my $lastUpdateTime = 0;
   my $lastEventTime = 0;
   my $debounceQuietPeriod = 15;
   my $debounceRelevantEventsPeriod = 1;
   my $relevantEvents = 1; # force a call to Update() on startup

   my $recurringId = Mojo::IOLoop->recurring( 0.5 => sub ($loop) {
      try {
         # Updating with sizes can be slow, so only do this if:
         # - it's been more than 5s since the last event; and
         # - it's been more than 55s since the last time sizes were updated.
         if(time - $lastEventTime >= 5 && time - $lastSizesUpdateTime >= 55) {
            $lastSizesUpdateTime = time;   # set at dispatch, not completion - prevents a second
                                            # overlapping sizes fetch being kicked off before this
                                            # one (genuinely slow - see update's own
                                            # comment) has had a chance to land
            flog("eventHandler:tick: updating docker containers with sizes");
            update( { 'updateSizes' => 1 }, undef );
         }
         elsif($relevantEvents && time - $lastEventTime >= $debounceRelevantEventsPeriod) {
            flog("eventHandler:tick: updating docker containers without sizes after ${debounceRelevantEventsPeriod}s after relevant events");
            $relevantEvents = 0;
            update( {}, undef );
         }
         elsif(time - $lastUpdateTime >= $debounceQuietPeriod) {
            $lastUpdateTime = time;
            flog("eventHandler:tick: updating docker containers without sizes after ${debounceQuietPeriod}s");
            update( {}, undef );
         }
      }
      catch {
         flog("eventHandler::on_tick: caught exception: " . (ref($_) ? $_->dbg : $_));
      };

      # Start any pending IDE launches whose launcher path has appeared - see
      # EventDaemon::LaunchReadiness::check_pending_launches's own comment.
      check_pending_launches();

      # Re-check any reservation restart-recovery found still genuinely in-flight, or newly
      # enqueued by a lost lifecycle-hook claim - see
      # EventDaemon::LaunchRecovery::check_launch_recovering's own comment.
      check_launch_recovering();

      # Once shutdown has been requested, keep returning control to the outer while(1) loop on
      # this tick's own ~0.5s cadence rather than leaving eventHandler blocked in Mojo::IOLoop
      # ->start indefinitely - $STOP_EVENT_LOOP itself is an ordinary, unconditional stop (see
      # its own comment), so this always succeeds immediately; it's the outer loop's own
      # drain_complete() check, run fresh every time eventHandler returns, that actually decides
      # whether it's safe to let the process exit yet. Without this, that decision would only
      # get revisited whenever something else happens to end eventHandler on its own (the
      # /events stream dropping, say) - real, but unpredictable and unbounded - and a stuck
      # drain outliving an external force-kill's own patience would abandon in-flight work
      # exactly as this whole mechanism exists to prevent, just via a different trigger.
      $STOP_EVENT_LOOP->() if $SIGNAL_RECEIVED;
   } );

   # Persistent, non-blocking streamed GET /events - see this file's own header comment for the
   # full reasoning (inactivity_timeout=>0, no request_timeout, both deliberate). Plain
   # newline-delimited JSON, one event object per line - a running buffer is kept across on_read
   # calls since a call may deliver a partial line or several at once, the same discipline
   # Util::docker_exec's own frame demuxer uses for exec output.
   my $buf = '';
   call_socket_api(
      $CONFIG->{'docker'}{'socket'},
      '/events',
      {
         'inactivity_timeout' => 0,
         'on_read' => sub ($bytes) {
            $buf .= $bytes;
            while( (my $i = index($buf, "\n")) >= 0 ) {
               my $line = substr($buf, 0, $i);
               $buf = substr($buf, $i + 1);
               next unless length($line);

               my $event;
               eval { $event = decode_json($line); 1 } or do {
                  flog("docker events: JSON decode failed: $@ ; line=[$line]");
                  next;
               };

               $eventCount++;
               $lastEventTime = time;

               try {
                  $relevantEvents += onEvent($event, $eventCount);
               }
               catch {
                  flog("eventHandler::on_read #$eventCount: caught exception: " . (ref($_) ? $_->dbg : $_));
               };
            }
         },
      },
      sub ($result, $err) {
         # Fires exactly once, whenever the stream ends for any reason - graceful EOF,
         # connection error, or - notably NOT - our own shutdown: Mojo::IOLoop->stop
         # interrupts the stream without ever calling this back. So reaching here always means
         # "the stream ended on its own" - a routine, expected occurrence (Docker restarts,
         # connection blips - see this file's own header comment), completely unrelated to
         # shutdown most of the time. Always ask to stop immediately and unconditionally (see
         # $STOP_EVENT_LOOP's own comment for why that's always safe): eventHandler returns, the
         # outer while(1) loop below reconnects right away, exactly as it always has - this must
         # never be held up waiting for in-flight work to drain, or an ordinary reconnect racing
         # a busy dispatch would silently stall event processing indefinitely, with no shutdown
         # involved at all.
         flog("docker events: stream ended" . ( $err ? " with error: $err" : ( $result ? sprintf(" (code=%d)", $result->code) : '' ) ));
         $STOP_EVENT_LOOP->();
      }
   );

   # An ordinary, unconditional stop - deliberately not gated. Confirmed against Mojo::IOLoop's
   # own POD/source: stop "will not interrupt any existing connections and the event loop can be
   # restarted by running start again" (a one-line delegation to the reactor's own stop, which
   # just clears a flag checked between ticks - it doesn't touch registered timers/streams/
   # transactions). So calling this never by itself harms an in-flight, non-detached hook exec's
   # own still-open docker_exec connection - that connection lives on the same persistent
   # Mojo::IOLoop singleton regardless of how many eventHandler stop/restart cycles happen while
   # it's in flight. What actually severed such a connection, previously, was never stop() alone
   # - it was the *process itself exiting* right after, with no gate at all. That's the one
   # thing worth gating, and it belongs at the outer while(1) loop's own drain_complete() check
   # below, the single place that decides whether the process actually exits - not here.
   $STOP_EVENT_LOOP = sub { Mojo::IOLoop->stop; };

   try {
      Mojo::IOLoop->start;
   }
   catch {
      flog("eventHandler: caught exception: " . (ref($_) ? $_->dbg : $_));
      sleep 1 unless $SIGNAL_RECEIVED; # Rate-limit crash loops; skip if we're shutting down.
   };

   # Reset to no-op so a late SIGTERM arriving after loop exit doesn't call stop on a dead loop.
   $STOP_EVENT_LOOP = sub {};

   # Mojo::IOLoop is a singleton, reused across every eventHandler() call - explicitly remove
   # this call's own recurring timer or a later restart accumulates a second, overlapping one
   # alongside it. See this sub's own header comment for why that matters, not just tidiness.
   Mojo::IOLoop->remove($recurringId);

   flog("eventHandler: Ending...");
}

####################################################################################################

flog({ 'service' => 'docker-event-daemon', 'file' => "/var/log/$ENV{'USER'}/$ENV{'USER'}.log" });
flog("Starting...");

# Startup config loads (here and the restart-recovery sweep below) are fatal on a core-file
# parse failure: this daemon cannot manage containers without them, so a corrupt one exits for
# s6 to restart (see Data::$CORE_PARSE_FAILURE_FATAL). Cleared before the event loop so the
# per-event reloads there instead skip that one event rather than exiting the daemon.
$Data::CORE_PARSE_FAILURE_FATAL = 1;
Data::load('config.json');

# Create temporary path needed for cache and log files.
if( ! -d $CONFIG->{'tmpPath'} ) {
   mkpath( [ $CONFIG->{'tmpPath'} ], 0, 0755 );
}

# Write an initial containers.json synchronously before entering the event loop.
# This ensures the Perl API server (nginx) always finds a current containers.json
# on its first request, avoiding the startup race where profiles are loaded with
# an empty network list because containers.json has not yet been written.
# update only ever queues its request; nothing is driving Mojo::IOLoop's reactor yet at
# this point in the script, so run it just long enough to let this one call settle - the same
# "run until done, then stop" pattern any of this file's own dispatch closures use implicitly
# once eventHandler's own Mojo::IOLoop->start is running, just applied once, standalone, here.
# There is nothing else this process could usefully be doing concurrently with this one
# call anyway (no /events stream, no launch dispatch - both start only once eventHandler runs),
# so there's no concurrency to lose by waiting for it inline.
flog("Writing initial container state synchronously...");
update( {}, sub { Mojo::IOLoop->stop; } );
Mojo::IOLoop->start unless Mojo::IOLoop->is_running;

# Recovers any launch stage left 'running' by a previous, now-dead docker-event-daemon process -
# see EventDaemon::LaunchRecovery::restart_recovery_sweep's own comment. Deliberately placed
# only here, not inside eventHandler (which restarts on stream-close/crash - see this file's own
# banner) - this must run once per *process* lifetime, not once per eventHandler restart.
restart_recovery_sweep();

# Startup is done; the event loop's own per-event reloads must skip a bad reload rather than
# exit the daemon (see the startup load above and Data::$CORE_PARSE_FAILURE_FATAL).
$Data::CORE_PARSE_FAILURE_FATAL = 0;

# Restart eventHandler if the 'docker events' stream closes unexpectedly (e.g. Docker restart).
# The one real gate on this process actually exiting: a signal alone is not enough while
# EventDaemon::LaunchDispatch::drain_complete() is still false - see its own comment. Looping
# around instead just calls eventHandler() again, which refuses new dispatch (already true by
# now) but otherwise runs normally, including servicing whatever's still in flight, until a
# later iteration finds the condition true.
while(1) {
   eventHandler();

   last if $SIGNAL_RECEIVED && drain_complete();
   sleep 1;
}
flog("Exiting.");

1;
