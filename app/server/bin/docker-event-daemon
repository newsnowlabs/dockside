#!/usr/bin/perl

# docker-event-daemon
#
# A daemon that keeps Dockside's container state file (containers.json) in sync with the live
# Docker engine, bridging Docker's runtime state to Dockside's own data layer so the application
# always has an up-to-date view of running containers.
#
# Event loop (eventHandler):
# - A persistent, non-blocking streamed GET /events (Mojo::IOLoop, via Util::call_socket_api_async)
#   - not a spawned `docker events` subprocess. Maps directly onto `docker events --format
#   "{{ json . }}"`'s own output: newline-delimited JSON, one event object per line, verified
#   live against this environment's own daemon (see
#   docs/plans/lifecycle-hooks-review-followup.md item F3) - no demuxing needed here, unlike exec
#   output.
# - Runs a 0.5s recurring timer (Mojo::IOLoop->recurring) alongside the event stream, on the same
#   reactor - verified live that a long-held-open stream and a recurring timer coexist correctly
#   without blocking each other.
# - The /events call's own inactivity_timeout is disabled (0) deliberately: this stream is meant
#   to run forever, and Docker's own quiet periods routinely exceed Mojo's 20s default (verified
#   live: idle for 22s with inactivity_timeout=>0 stayed open, no spurious error). No
#   request_timeout either, for the same reason - that bounds the whole call regardless of
#   activity, which is wrong for a perpetual stream.
#
# Debounced updates (timer tick):
# Three tiers of update frequency:
# 1. With sizes    - every ~55s, but only when no events have arrived for 5+ seconds (slow, so deferred).
# 2. After events  - within 1s of a relevant event (fast refresh).
# 3. Heartbeat     - every 15s regardless (keeps state fresh even when idle).
#
# Event handling (onEvent):
# Listens for specific Docker event types:
# - network connect/disconnect     -> triggers a container update.
# - container stop/create/destroy  -> triggers a container update.
# - container start                -> triggers onContainerStart, which kicks off the launch:-DAG
#                                     (launch:prep -> {launch:git, launch:ide, lifecycle:*} -
#                                     see this file's own "Launch dispatch orchestration"
#                                     section) via launch_advance. Every dispatch is a
#                                     non-blocking docker_exec_async call, never a fork; each
#                                     stage's own completion callback re-scans for newly-eligible
#                                     dependents, so a single launch_advance call drives the
#                                     whole DAG to completion on its own.
#
# Container state update (_update_merge / update_async):
# - Calls the Docker API (/containers/json) via a Unix socket, non-blocking (call_socket_api_async).
#   size=true (only when 'updateSizes' is requested and $CONFIG->{'docker'}{'sizes'} allows it)
#   is genuinely, not just theoretically, slow - measured at ~30x the no-sizes call's own latency
#   against a real daemon with a modest container count, scaling with fleet size - so this one
#   was worth migrating even though it's infrequent (~every 55s at most): the reactor would
#   otherwise stall for that whole duration, undermining the entire point of this daemon being
#   async at all. docker_container_path_exists (used by launcher_path_exists) stays blocking -
#   confirmed genuinely fast (a single-container stat, not proportional to fleet size) and not
#   worth the conversion for its own sake.
# - Rebuilds the container map: short ID, name, status, image, ports, volume mounts
#   (including the IDE volume path and host-data volume path).
# - Preserves the last-known Size value when not requesting a fresh size calculation (avoiding slow calls).
# - Writes results to containers.json via cacheReadWrite.
# - Triggers Reservation->load_clean_map to assign expiry times to reservations
#   whose containers have disappeared.
#
# Lifecycle:
# - Runs in an outer while(1) loop: if eventHandler crashes or the /events stream closes (Docker
#   restart, connection error, etc.), it restarts automatically after 1 second.
# - Handles SIGTERM/SIGINT/SIGQUIT cleanly: sets a flag and stops the Mojo::IOLoop reactor -
#   verified live that Mojo::IOLoop->stop cleanly interrupts an in-flight streamed request with
#   no hang and no completion callback firing, so there is no subprocess-style two-stage
#   SIGTERM-then-SIGKILL shutdown to do here any more; the process just exits.

use v5.36;

use JSON;

use Try::Tiny;
use File::Path;
use Time::HiRes qw(time);

use Mojo::IOLoop;

use Util qw(cacheReadWrite flog call_socket_api call_socket_api_async docker_container_path_exists docker_exec_async sanitize_sensitive_text unique);
use Exception;
use Data qw($CONFIG);
use Reservation;
use Reservation::Mutate qw(hook_claim_if_not_running);
use Containers;
use User;

# mountIDE:false Dockside devtainers populate their own /opt/dockside volume
# during entrypoint startup. Defer IDE launch until the configured launcher path
# exists instead of retrying docker exec failures.
my $LAUNCH_READY_MAX_WAIT = 60; # seconds
my $LAUNCH_READY_INTERVAL = 1;  # seconds between Docker API readiness checks

my %pendingLaunch;  # containerId => { deadline => epoch, nextTime => epoch, launcher => path, reservationId => id }

# containerId => 1, seeded by the restart-recovery sweep, for a reservation whose launch
# was still genuinely in-flight (a real, live exec, not yet actually finished) at the exact
# moment this DED process started - never added during ordinary operation otherwise, where every
# live dispatch's own completion callback is the sole, sufficient resolver (see this file's own
# "Launch dispatch orchestration" section header comment on why per-tick polling is otherwise
# unnecessary). Found live, not assumed: restart-recovery's own hook_is_running self-heal check
# correctly does nothing when a stage's exec really is still running (it must not falsely
# resolve a genuinely live exec) - but the process that owned that exec's completion callback is
# gone, permanently, and no Docker event exists that this daemon treats as "an exec finished, go
# check on it" (docker events' own exec_die carries no reservation/stage context). Left
# unaddressed, such a stage stays 'running' forever even after its real exec genuinely
# completes. on_tick below re-checks every entry here until launch_in_flight() says there's
# nothing left to recover, then drops it - scoped to this one, self-limiting case.
#
# Second, ordinary-operation seeding source: _launch_dispatch_hook_stage below, when its own
# hook_claim_if_not_running loses the claim on lifecycle:launch/lifecycle:start to a concurrent
# on-demand run_hook_sync invocation of the same name (the only two DAG stage names externally
# reachable that way). DED isn't the owner of that dispatch's completion in this case, so it
# can't rely on its own completion callback the way every other stage can - the same "who
# resolves this" gap the restart case has, just triggered by losing a race instead of by a
# process restart. Reusing this mechanism rather than inventing a second one: the reconciliation
# loop's own logic (re-check until settled, then drop) is identical either way.
my %launchRecovering;

my $SIGNAL_RECEIVED = 0;
my $STOP_EVENT_LOOP = sub { };

$SIG{'INT'} = $SIG{'QUIT'} = $SIG{'TERM'} = sub {
   # This will stop the Mojo::IOLoop reactor - see eventHandler's own comment on why that's a
   # clean, sufficient shutdown now (verified live), with no subprocess to separately terminate.
   flog("eventHandler: Received SIGTERM; preparing to exit.");
   $SIGNAL_RECEIVED = 1;
   $STOP_EVENT_LOOP->();
};

sub launcher_wait_path ($reservation) {
   return undef if $reservation->profileObject->should_mount_ide;

   return $reservation->ide_command_launcher();
}

# Returns true if the launcher exists inside the container AND its mtime is >= $since
# (meaning it was written during the current container run, not left over from a previous one).
# $since is undef when no staleness check is needed (e.g. first-ever launch with no prior volume).
sub launcher_path_exists ($reservation, $launcher, $since = undef) {
   my ($exists, $mtime) = docker_container_path_exists(
      $CONFIG->{'docker'}{'socket'},
      $reservation->containerId,
      $launcher
   );
   return 0 unless $exists;
   # $mtime is whole seconds (Docker's stat has no sub-second precision by the time it's
   # parsed); $since may carry a Time::HiRes fractional part, so floor it before comparing
   # or a launcher written in the same second as $since is wrongly seen as predating it.
   return 0 if defined($since) && defined($mtime) && $mtime < int($since);
   return 1;
}

sub queue_pending_launch ($reservation, $context, $launcher, $since) {
   my $containerId = $reservation->containerId;

   # The container is running but the IDE is not yet launched. Until it is,
   # route UI IDE links according to the requested IDE, not any previous value. Narrow store -
   # see Reservation::store_fields' own comment - since this reservation may concurrently be
   # written by other, unrelated fields.
   $reservation->data('runningIDE', $reservation->meta('IDE'));
   $reservation->store_fields( { 'data' => { 'runningIDE' => $reservation->data('runningIDE') } } );

   $pendingLaunch{$containerId} = {
      deadline      => time() + $LAUNCH_READY_MAX_WAIT,
      nextTime      => time() + $LAUNCH_READY_INTERVAL,
      launcher      => $launcher,
      reservationId => $reservation->id,
      startTime     => $since,
   };

   flog("$context: delaying IDE launch for reservationId=" . $reservation->id . " with containerId=$containerId: launcher '$launcher' is not present yet (or predates container start)");
}

sub launch_or_queue_until_launcher_ready ($reservation, $context, $since) {
   my $launcher = launcher_wait_path($reservation);

   if(defined($launcher) && $launcher ne '' && !launcher_path_exists($reservation, $launcher, $since)) {
      queue_pending_launch($reservation, $context, $launcher, $since);
      return undef;
   }

   # Kicks off the whole launch:prep -> {launch:git, launch:ide, lifecycle:*} DAG (item F3) -
   # fire-and-forget in the sense that dispatch is non-blocking, but self-propagating: each
   # stage's own dispatch closure calls launch_advance again once it resolves, so a single call
   # here drives the whole DAG to completion without anything needing to poll it - see
   # launch_advance's own comment. A truthy return here only means the DAG was successfully
   # kicked off, not that it's finished; real progress is recorded asynchronously in
   # data('hooks') as each stage resolves.
   launch_advance($reservation);
   return 1;
}

# --- Launch dispatch orchestration (item F3) ---
#
# Small, declarative dependency table + one generic driver, owned entirely by docker-event-
# daemon itself - not Reservation.pm (see docs/plans/lifecycle-hooks-review-followup.md item K:
# Reservation.pm should not own concurrency/orchestration, only pure data operations and
# fork-agnostic building blocks; DED owns "what to dispatch next"). Reservation.pm/
# Reservation::Launch.pm's existing pure accessors (ide_command/hook_script/_hook_env/
# ide_command_env) and pure state-recording methods (hook_status_*/increment_start_count/
# store_fields) are called directly from here - reused as-is, not reimplemented.
#
# TRANSPORT: every dispatch below is non-blocking (Util::docker_exec_async), never a fork. This
# is what collapses the entire self-heal-vs-on_success race class that a forked, fork-per-tick
# design was vulnerable to (see item F2's own history in this doc for the bug that motivated
# this rewrite): there is only ever one process, so "which of two paths resolves this stage
# first" is not a question that can be asked any more - the completion callback is the sole,
# unambiguous resolver. It also means self-heal (polling a 'running' stage to check whether its
# owning process died) is *only* ever needed once, at DED's own startup, for a stage left
# 'running' by a *previous*, now-dead DED process - see this file's own restart-recovery sweep,
# near the bottom. During normal operation, launch_advance below deliberately does NOT poll a
# 'running' stage at all: it will resolve via its own completion callback, guaranteed, unless
# DED itself dies - a case the restart-recovery sweep alone exists to cover. This removes the
# old fork model's %launchInFlight per-tick polling entirely, not just relocates it - nothing
# needs to keep re-checking an in-flight launch, because the callback chain drives itself to
# completion on its own.
my $ROOT_USER    = sub ($reservation) { 'root' };
my $NONROOT_USER = sub ($reservation) { $reservation->unixuser() };

# Two genuinely different dispatch shapes, not one forced-uniform shape: launch:prep/launch:git/
# launch:ide are bare launch.sh entry-point functions (no hook name/script involved - see
# _launch_dispatch_exec below), while lifecycle:launch/lifecycle:start are real, profile-
# declared hooks, dispatched via _launch_dispatch_hook_stage's own (non-blocking) exec logic -
# deliberately not Reservation::dispatch_hook_exec, which is blocking and stays reserved for
# run_hook_sync's on-demand path (item K point 8) - see _launch_dispatch_hook_stage's own
# comment for the resulting, accepted duplication.
my %LAUNCH_STAGES = (
   'launch:prep' => {
      depends_on => [],
      dispatch   => \&_launch_dispatch_prep,
   },
   'launch:git' => {
      depends_on => ['launch:prep'],
      applicable => sub ($reservation) { !!@{ $reservation->profileObject->gitURLs // [] } },
      dispatch   => sub ($reservation, $cb) {
         _launch_dispatch_exec( $reservation, 'launch:git', 'launch_git', $NONROOT_USER->($reservation), {
            'extra_env' => [
               "DOCKSIDE_START_COUNT=" . ( $reservation->data('startCount') // 0 ),
               "DEVCONTAINER_VSCODE_EXTENSIONS=" . encode_json( $reservation->data('vscode') ),
            ],
         }, $cb );
      },
   },
   'launch:ide' => {
      depends_on => ['launch:prep'],
      dispatch   => sub ($reservation, $cb) {
         _launch_dispatch_exec( $reservation, 'launch:ide', 'launch_ide', $NONROOT_USER->($reservation), {
            'detach'    => 1,
            'extra_env' => [ "IDE=" . $reservation->meta('IDE') ],
         }, $cb );
      },
   },
   'lifecycle:launch' => {
      depends_on => ['launch:git'],
      applicable => sub ($reservation) {
         !!( $reservation->profileObject->hooks->{'lifecycle:launch'} && ( $reservation->data('startCount') // 0 ) == 1 )
      },
      dispatch   => sub ($reservation, $cb) { _launch_dispatch_hook_stage( $reservation, 'lifecycle:launch', $cb ) },
   },
   'lifecycle:start' => {
      depends_on => ['lifecycle:launch'],
      applicable => sub ($reservation) { !!$reservation->profileObject->hooks->{'lifecycle:start'} },
      dispatch   => sub ($reservation, $cb) { _launch_dispatch_hook_stage( $reservation, 'lifecycle:start', $cb ) },
   },
);

my @LAUNCH_STAGE_NAMES = keys %LAUNCH_STAGES;

# Maps a raw hook_status() record to the DAG's simpler done/failed/timedOut vocabulary - shared
# by _launch_dispatch_hook_stage and anywhere else that needs to translate a settled hookStatus
# entry into a state to record via launch_resolve_stage.
sub _launch_state_from_hook_status ($status) {
   return 'failed'   unless $status;
   return 'failed'   if $status->{'state'} eq 'aborted';
   return 'timedOut' if $status->{'timedOut'};
   return ( $status->{'exitCode'} // 1 ) == 0 ? 'done' : 'failed';
}

sub launch_resolve_stage ($reservation, $stage, $state) {
   $reservation->hook_status_completed( $stage, { 'state' => $state } );
}

sub _launch_deps_cleared ($reservation, $stage) {
   for my $dep ( @{ $LAUNCH_STAGES{$stage}{'depends_on'} } ) {
      my $status = $reservation->hook_status($dep);
      return 0 unless $status && $status->{'state'} =~ /^(?:done|skipped)$/;
   }
   return 1;
}

# Marks every launch:-DAG stage 'pending' for a fresh launch cycle. Called exactly once per
# genuine container 'start' Docker event (onContainerStart, before its first launch_advance
# call for that event) - never from the pendingLaunch retry loop, which is for waiting out the
# *same* start event and must keep seeing whatever this reset already put in place. Sends only
# the 5 launch:-stage names, via store_fields - never the whole hooks.status hash, which may
# also hold entries for on-demand/custom hook names this has no business touching.
#
# Also updates $reservation's own in-memory hooks.status directly, mirroring
# Reservation::_hook_status_store_one's own discipline (see its comment) - store_fields/update()
# only ever writes a *fresh*, separately-loaded copy under mutate()'s lock (see
# Reservation::Mutate::update: it mutates $by_id->{$id}, never $self), so without this,
# launch_advance's own very next call - using this same $reservation object - would still see
# every stage's *previous* launch cycle's resolved state and dispatch nothing at all. Found
# exactly this way, live: a restart's onContainerStart correctly reached this function, but the
# whole DAG then silently never dispatched anything, because _launch_deps_cleared/
# launch_maybe_dispatch's own 'pending' checks were reading stale, pre-reset state.
sub launch_reset_stages ($reservation) {
   my $entries = { map { $_ => { 'name' => $_, 'state' => 'pending' } } @LAUNCH_STAGE_NAMES };
   my $status = ( $reservation->{'data'}{'hooks'} //= {} )->{'status'} //= {};
   %$status = ( %$status, %$entries );
   $reservation->store_fields( { 'data' => { 'hooks' => { 'status' => $entries } } } );
}

# True if this reservation's launch DAG still has work left. launch:ide is deliberately excluded
# once dispatched: unlike every other stage it never resolves in the happy path (it's the
# perpetual IDE process, not a script that exits) and has no dependents, so treating its ongoing
# 'running' state as "still needs attention" would mean every healthy devtainer stays flagged
# forever. Used only by the restart-recovery sweep below to decide which reservations need
# reconciling at DED startup.
sub launch_in_flight ($reservation) {
   for my $name (@LAUNCH_STAGE_NAMES) {
      next if $name eq 'launch:ide';
      my $state = ( $reservation->hook_status($name) // {} )->{'state'} // 'pending';
      return 1 if $state eq 'pending' || $state eq 'running';
   }
   return 0;
}

# Advances this reservation's launch DAG by one scan: dispatches whatever's newly eligible
# ('pending' with its dependencies cleared - see _launch_deps_cleared). Deliberately does NOT
# poll anything 'running' - see this section's own header comment for why that's only ever
# needed once, at startup, not here. Each dispatch attempt is individually wrapped: a synchronous
# failure building one stage's request (an exception before any I/O even begins) must not stop
# the rest of this scan, and - since launch_advance is reached from asynchronous completion
# callbacks as often as from a synchronous caller - cannot rely on an outer try/catch existing
# at all (see docs/plans/lifecycle-hooks-review-followup.md item F3 concern 1).
sub launch_advance ($reservation) {
   for my $name (@LAUNCH_STAGE_NAMES) {
      my $status = $reservation->hook_status($name);
      my $state = ( $status // {} )->{'state'} // 'pending';

      next unless $state eq 'pending' && _launch_deps_cleared($reservation, $name);

      try {
         launch_maybe_dispatch($reservation, $name);
      }
      catch {
         flog("docker-event-daemon::launch_advance: caught exception dispatching '$name' for reservationId=" . $reservation->id . ": " . (ref($_) ? $_->dbg : $_));
         launch_resolve_stage($reservation, $name, 'failed');
      };
   }
}

# Dispatches $stage if applicable, or resolves it 'skipped' (synchronous). Idempotency guard:
# with no forking, hook_status_started (called synchronously, before any async I/O begins, by
# _launch_dispatch_exec/_launch_dispatch_hook_stage below) is what makes a stage's 'running'
# status visible to *this same process* immediately - there is no IPC gap for a second,
# re-entrant launch_advance call (from this stage's own completion callback, or a differently-
# triggered call) to race against, unlike the old fork model where a forked child's write
# landed asynchronously relative to the parent's own view. This is a direct, structural
# consequence of there being only one process now, not a guard bolted on afterward.
sub launch_maybe_dispatch ($reservation, $stage) {
   my $status = $reservation->hook_status($stage);
   return if $status && ( $status->{'state'} // '' ) ne 'pending';

   my $spec = $LAUNCH_STAGES{$stage};
   if ( $spec->{'applicable'} && !$spec->{'applicable'}->($reservation) ) {
      launch_resolve_stage( $reservation, $stage, 'skipped' );
      launch_advance($reservation);   # synchronous resolution - re-scan now for newly-eligible dependents
      return;
   }

   $spec->{'dispatch'}->( $reservation, sub { launch_advance($reservation); } );
}

# Dispatches a bare launch.sh entry-point function (launch:prep/launch:git/launch:ide - no hook
# name/script involved, unlike _launch_dispatch_hook_stage) via docker_exec_async, and records
# its outcome. Base env is _hook_env() (GIT_URL/SSH_KNOWN_HOSTS_DOMAINS/DOCKSIDE_OPTION_*/
# GH_TOKEN) plus ide_command_env() (the reservation's own IDE-record env) - both were already
# part of every launch before this split, for every stage that came from it. $opts:
#   detach     => 1        required for launch:ide specifically - dispatches via Detach:true and
#      returns immediately: only hook_status_started/hook_status_set_running_details ever get
#      called for it in the normal case, never launch_resolve_stage - it stays 'running'
#      indefinitely, either overwritten by the next restart's fresh dispatch or lazily
#      self-healed by the restart-recovery sweep.
#   extra_env  => [...]    "KEY=VALUE" strings specific to this stage, on top of the base env.
#   on_success => sub ($reservation) { ... }   optional, called (only on real, confirmed
#      success) after the exec completes but before launch_resolve_stage - synchronous, not
#      given its own callback: increment_start_count (the only current user) is a fast,
#      synchronous file write like every other Reservation.pm state operation, not a Docker
#      socket call, so it needs no async treatment of its own.
#   $cb->()    called exactly once, once this stage has been resolved (or, for Detach, once
#      dispatch is confirmed to have at least started) - drives launch_advance's own re-scan.
sub _launch_dispatch_exec ($reservation, $stage, $function, $user, $opts, $cb) {
   my @Command = $reservation->ide_command();
   die Exception->new( 'msg' => 'Internal error - no IDE command configured', 'dbg' => 'docker-event-daemon::_launch_dispatch_exec: ide_command() returned empty' ) unless @Command;
   $Command[-1] = $function;

   my $owner = $reservation->owner('username');
   my $userObj = User->load($owner);
   die Exception->new( 'msg' => "The owner of this devtainer ('$owner') no longer exists", 'status' => 400 ) unless $userObj;

   my @env = (
      ( map { my $e = $_; $e =~ s/^--env=//; $e } $reservation->_hook_env($userObj) ),
      ( map { my $e = $_; $e =~ s/^--env=//; $e } $reservation->ide_command_env() ),
      @{ $opts->{'extra_env'} // [] },
   );

   my $timeout = $CONFIG->{'hooks'}{'defaultTimeoutSeconds'} || 120;
   my $containerId = $reservation->containerId();

   # No logPath - launch:prep/launch:git still log in-container to $LOG as today. launch:ide
   # never had one to begin with (perpetual, Detach:true). Synchronous, before any async I/O
   # begins - see launch_maybe_dispatch's own comment on why that alone is what makes a
   # re-entrant launch_advance call safe.
   $reservation->hook_status_started($stage, undef);

   flog( "docker-event-daemon::_launch_dispatch_exec: DISPATCHING '$stage' (via exec API): " . join( '|', map { sanitize_sensitive_text($_) } @Command ) );

   docker_exec_async( $CONFIG->{'docker'}{'socket'}, $containerId, {
      'Cmd' => \@Command, 'User' => $user, 'Env' => \@env,
   }, {
      ( $opts->{'detach'}
         ? ( 'Detach' => 1 )
         : ( 'inactivity_timeout' => $timeout + 30, 'request_timeout' => $timeout ) ),
      # No real pid to pass (DED never forks for this any more) - hook_status_set_running_details
      # accepts undef here exactly as designed; only the restart-recovery sweep's own
      # hook_is_running check ever reads it, and that falls through to the execId-based check
      # gracefully when pid is undef (see hook_is_running's own comment).
      'on_created' => sub ($execId) { $reservation->hook_status_set_running_details($stage, undef, $execId); },
   }, sub ($result, $err) {
      try {
         if ( !$result ) {
            flog("docker-event-daemon::_launch_dispatch_exec: '$stage' failed to dispatch: $err");
            launch_resolve_stage($reservation, $stage, 'failed');
            $cb->();
            return;
         }

         if ( $opts->{'detach'} ) {
            $opts->{'on_success'}->($reservation) if $opts->{'on_success'};
            $cb->();
            return;
         }

         my $rc = $result->{'exitCode'};
         my $timedOut = $result->{'timedOut'} ? 1 : 0;
         my $success = !$timedOut && defined($rc) && $rc == 0;

         $opts->{'on_success'}->($reservation) if $success && $opts->{'on_success'};
         launch_resolve_stage( $reservation, $stage, $timedOut ? 'timedOut' : ( $success ? 'done' : 'failed' ) );
         $cb->();
      }
      catch {
         flog("docker-event-daemon::_launch_dispatch_exec: caught exception resolving '$stage': " . (ref($_) ? $_->dbg : $_));
         $cb->();
      };
   } );
}

# launch:prep's own dispatch - not just a plain _launch_dispatch_exec call, because this stage
# carries two things specific to it alone, both preserved from the pre-item-F single-exec
# design this whole split replaces: (1) SSH-related env (only when this profile has ssh enabled
# at all) plus OWNER_DETAILS/SSH_AGENT_KEYS; (2) DOCKSIDE_START_COUNT's compute-before/persist-
# after-confirmed-success dance - computed here as a *prospective* value (purely informational
# for the container), but only ever persisted via on_success once _launch_dispatch_exec confirms
# real success - never on a failed or merely-attempted dispatch, which would otherwise burn a
# count on a launch that never actually happened. This is exactly the moment data('startCount')
# becomes the value launch:git's own dispatch and the lifecycle:launch/lifecycle:start
# 'applicable' predicates read afterward - by the time either dispatches, launch:prep has
# already succeeded, so the count is already final.
sub _launch_dispatch_prep ($reservation, $cb) {
   my $owner = $reservation->owner('username');
   my $userObj = User->load($owner);
   die Exception->new( 'msg' => "The owner of this devtainer ('$owner') no longer exists", 'status' => 400 ) unless $userObj;

   my @env;
   if ( $reservation->profileObject->ssh ) {
      my @developersMeta = split( ',', $reservation->meta('developers') );
      my @developers = grep { !/^role:/ } @developersMeta;
      my %developerRoles = map { s/^role://; ( $_ => 1 ); } grep { /^role:/ } @developersMeta;
      my @usersHavingDeveloperRoles = map { $developerRoles{ $_->{'role'} } ? $_->{'username'} : () } @{ User->viewers };
      my @usernames = unique(
         $reservation->owner('username'),
         $reservation->meta('access')->{'ssh'} eq 'developer' ? ( @developers, @usersHavingDeveloperRoles ) : ()
      );
      my @Users = map { User->load($_) } @usernames;
      my @authorized_keys = sort { $a cmp $b } unique map { $_ ? @{ $_->authorized_keys() } : () } @Users;
      push @env,
         "AUTHORIZED_KEYS=" . encode_json( \@authorized_keys ),
         "HOSTDATA_PATH=$CONFIG->{'ssh'}{'path'}",
         "SSHD_ENABLE=1";
   }
   push @env,
      "OWNER_DETAILS=" . encode_json( $userObj->details_full ),
      "SSH_AGENT_KEYS=" . encode_json( $userObj->keypairs_all() );

   # Store before dispatch so the UI reflects the intended IDE immediately, including during
   # any retry window before the dispatch succeeds. Narrow store - see store_fields' own comment.
   $reservation->data( 'runningIDE', $reservation->meta('IDE') );
   $reservation->store_fields( { 'data' => { 'runningIDE' => $reservation->data('runningIDE') } } );

   # A *prospective* value, purely informational for the container - launch:prep dispatches at
   # most once per cycle (the same idempotency guard every launch:-stage gets), so nothing else
   # can be concurrently incrementing this reservation's startCount right now. Not the persisted
   # source of truth lifecycle:launch's own applicable() gate reads - see
   # Reservation::increment_start_count's own comment for why that needs a genuine
   # read-under-lock, not a value computed here and stored later.
   my $startCount = ( $reservation->data('startCount') // 0 ) + 1;

   return _launch_dispatch_exec( $reservation, 'launch:prep', 'launch_prep', $ROOT_USER->($reservation), {
      'extra_env'  => [ @env, "DOCKSIDE_START_COUNT=$startCount" ],
      'on_success' => sub ($reservation) { $reservation->increment_start_count(); },
   }, $cb );
}

# Dispatches $name (lifecycle:launch/lifecycle:start) via docker_exec_async directly - not
# Reservation::dispatch_hook_exec, which is blocking and stays reserved for run_hook_sync's
# on-demand path (item K point 8). This does duplicate dispatch_hook_exec's own dispatch-and-
# record shape (open a log, wire on_created/on_output, interpret the result, call
# hook_status_completed) - a genuine, accepted consequence of the two paths needing genuinely
# different underlying primitives (blocking docker_exec vs non-blocking docker_exec_async), not
# an oversight; the parts that *can* be shared (env/Command building, via _hook_env/ide_command)
# already are, unchanged. Then translates the outcome into a launch_resolve_stage() call -
# deliberately not folded into hook_status_completed itself, since that's shared with genuinely
# on-demand invocations (including manual re-runs of these same two names via `dockside hook
# run`), which must never affect DAG state.
sub _launch_dispatch_hook_stage ($reservation, $name, $cb) {
   my $script = $reservation->hook_script($name);
   my @Command = $reservation->ide_command();
   die Exception->new( 'msg' => 'Internal error - no IDE command configured', 'dbg' => 'docker-event-daemon::_launch_dispatch_hook_stage: ide_command() returned empty' ) unless @Command;
   $Command[-1] = 'run_hook';
   push( @Command, $name, $script );

   my $owner = $reservation->owner('username');
   my $userObj = User->load($owner);
   die Exception->new( 'msg' => "The owner of this devtainer ('$owner') no longer exists", 'status' => 400 ) unless $userObj;

   my @env = map { my $e = $_; $e =~ s/^--env=//; $e } $reservation->_hook_env($userObj);

   my $timeout = $CONFIG->{'hooks'}{'defaultTimeoutSeconds'} || 120;
   my $containerId = $reservation->containerId();

   my $invocationId = sprintf( "%08x", int(rand(0xffffffff)) );
   my $logPath = "$CONFIG->{'tmpPath'}/r-" . $reservation->id() . "-hook-$invocationId.log";

   # Atomic claim, not a plain hook_status_started() write - lifecycle:launch/lifecycle:start
   # are the only two DAG stage names also reachable via run_hook_sync's on-demand path (when a
   # profile's hooks entry sets "manual": true on them), so a concurrent on-demand invocation of
   # the *same* name is genuinely possible here, unlike launch:prep/launch:git/launch:ide
   # (DED-exclusive, single writer, run_hook_sync rejects those as "not yet implemented" - no
   # lock needed). See Reservation::Mutate::hook_claim_if_not_running's own comment.
   my $claimedEntry = hook_claim_if_not_running( $reservation->id(), $name, $logPath, $Reservation::HOOK_HISTORY_MAX );
   unless ( $claimedEntry ) {
      # Lost the race to a concurrent on-demand invocation of the same name - it owns
      # completion now, not us. Don't resolve this stage (it isn't ours to resolve) and don't
      # dispatch a second real exec on top of it (exactly the bug this exists to prevent) - defer
      # to the restart-recovery reconciliation loop instead, widened to cover this case too (see
      # %launchRecovering's own comment above).
      flog( "docker-event-daemon::_launch_dispatch_hook_stage: '$name' already claimed by a "
          . "concurrent on-demand invocation - deferring to launchRecovering" );
      $launchRecovering{ $reservation->containerId } = 1;
      $cb->();
      return;
   }
   # Sync this process's own in-memory copy - mutate() only ever wrote a fresh, separately-
   # loaded copy (see hook_claim_if_not_running's own comment), not $reservation - so the
   # on_created callback below (hook_status_set_running_details) merges pid/execId onto this
   # fresh entry, not stale pre-claim state.
   ( $reservation->{'data'}{'hooks'} //= {} )->{'status'}{$name} = $claimedEntry;

   flog( "docker-event-daemon::_launch_dispatch_hook_stage: DISPATCHING '$name' (via exec API): " . join( '|', map { sanitize_sensitive_text($_) } @Command ) );

   open( my $log, '>>', $logPath )
      or die Exception->new( 'dbg' => "docker-event-daemon::_launch_dispatch_hook_stage: cannot open log '$logPath': $!" );
   $log->autoflush(1);

   docker_exec_async( $CONFIG->{'docker'}{'socket'}, $containerId, {
      'Cmd' => \@Command, 'User' => $reservation->unixuser(), 'Env' => \@env,
   }, {
      'inactivity_timeout' => $timeout + 30,
      'request_timeout'    => $timeout,
      'on_created' => sub ($execId) { $reservation->hook_status_set_running_details($name, undef, $execId); },
      'on_output'  => sub ($stream, $bytes) { print $log $bytes; },
   }, sub ($result, $err) {
      try {
         close($log);

         if ( !$result ) {
            flog("docker-event-daemon::_launch_dispatch_hook_stage: '$name' failed to dispatch: $err");
            $reservation->hook_status_completed( $name, { 'state' => 'aborted' } );
            launch_resolve_stage($reservation, $name, 'failed');
            $cb->();
            return;
         }

         my $rc = $result->{'exitCode'};
         my $timedOut = $result->{'timedOut'} ? 1 : 0;
         my $busy = ( defined($rc) && $rc == 2 && !$timedOut ) ? 1 : 0;

         $reservation->hook_status_completed( $name, {
            'state'    => 'done',
            'exitCode' => $rc,
            'timedOut' => $timedOut,
            'busy'     => $busy,
         } );
         launch_resolve_stage( $reservation, $name, _launch_state_from_hook_status( $reservation->hook_status($name) ) );
         $cb->();
      }
      catch {
         flog("docker-event-daemon::_launch_dispatch_hook_stage: caught exception resolving '$name': " . (ref($_) ? $_->dbg : $_));
         $cb->();
      };
   } );
}

# Pure, synchronous merge of an already-fetched Docker /containers/json response with the
# existing containers.json content - no I/O of its own. Split out from what used to be _update's
# single function (fetch + merge in one, called from inside cacheReadWrite's own held lock) so
# the (potentially slow - see update_async's own comment) fetch can happen *before* the lock is
# ever taken, leaving only this fast, pure step to run under it. $newContainersFromAPI is the
# decoded body of the API response; $oldJSON is cacheReadWrite's own existing-file content
# (read fresh, right before this runs - see update_async's own comment on why that's a genuine,
# if incidental, improvement over the old single-function shape, not just a refactor).
sub _update_merge ($newContainersFromAPI, $oldJSON) {
   my $oldContainers;
   try {
      $oldContainers = $oldJSON ? decode_json($oldJSON)->{'containers'} : {};
   }
   catch {
      $oldContainers = {};
   };

   my $idePath = $CONFIG->{'ide'}{'path'};
   my $hostDataPath = $CONFIG->{'ssh'}{'path'};

   my $newContainers;
   foreach my $c (@$newContainersFromAPI) {

      my $ID = substr($c->{'Id'}, 0, 12); # Truncate to Docker's standard short ID length.

      # For each mount point of interest, produce ['volume', $name] or ['bind', $source].
      my ($ideVolume) = map { $_->{'Type'} eq 'volume' ? ['volume', $_->{'Name'}] : ['bind', $_->{'Source'}] } grep { $_->{'Destination'} eq $idePath } @{$c->{'Mounts'}};
      my ($hostDataVolume) = map { $_->{'Type'} eq 'volume' ? ['volume', $_->{'Name'}] : ['bind', $_->{'Source'}] } grep { $_->{'Destination'} eq $hostDataPath } @{$c->{'Mounts'}};

      $newContainers->{$ID}{'docker'} = {
         'ID' => $ID, # Short ID (for now)
         'Names' => substr($c->{'Names'}[0], 1), # Skip leading '/'
         'CreatedAt' => $c->{'Created'}, # Was string; now unixtime
         'Status' => $c->{'Status'}, # String
         'Image' => $c->{'Image'}, # String
         'ImageId' => substr( substr($c->{'ImageID'}, 7), 0, 12), # Strip 'sha256:' prefix (7 chars), then truncate to short ID.
         'Size' => $c->{'SizeRw'},
         'Networks' => join(',', sort keys %{$c->{'NetworkSettings'}{'Networks'}})
      };

      # HashRef keyed on internal port looking up host port.
      # This is only needed when $CONFIG->{'gateway'}{'enabled'} is true (and this is deprecated)
      my $ports = { map { $_->{'PrivatePort'} => $_->{'PublicPort'} } @{$c->{'Ports'}} };

      $newContainers->{$ID}{'inspect'} = { 
         'Networks' => $c->{'NetworkSettings'}{'Networks'},
         'Ports' => $ports,
         'ideVolume' => $ideVolume,
         'hostDataVolume' => $hostDataVolume
      };

      # Copy the container Size from the oldContainer record if we haven't requested the Size on this run.
      if( $oldContainers && $oldContainers->{$ID} && $oldContainers->{$ID}{'docker'}{'Size'} ) {
         if( !$newContainers->{$ID}{'docker'}{'Size'} ) {
            $newContainers->{$ID}{'docker'}{'Size'} = $oldContainers->{$ID}{'docker'}{'Size'};
         }
      }

   }

   my $newContainersFile = { 'version' => Containers::CURRENT_VERSION, 'containers' => $newContainers };

   return encode_json($newContainersFile);
}

# Updates the container state by retrieving the current container list from the Docker API
# (non-blocking) and merging it with the existing container data. $opts->{'updateSizes'} (only
# when $CONFIG->{'docker'}{'sizes'} also allows it) adds Docker's own size=true, which computes
# every container's RW-layer diff size - genuinely slow, not just theoretically: measured at
# ~30x the no-sizes call's own latency against this host's real daemon with a modest container
# count, and size=true's cost scales with fleet size/filesystem activity, not something a better
# query fixes. This is exactly why this call is non-blocking at all: the point isn't to make
# size=true itself faster (it can't be - that cost is Docker's own, not this call's), it's that
# DED's own reactor - servicing /events and every in-flight launch dispatch - stays responsive
# for that whole duration instead of stalling on it.
#
# The fetch happens *before* cacheReadWrite is ever called, deliberately - nothing about
# fetching depends on containers.json's own content, so there's no correctness reason to hold
# its lock for the fetch's duration (unlike the old single-function _update, which held it for
# exactly that - a side effect of being written as one plain synchronous function passed
# straight into cacheReadWrite, not because the lock genuinely needed to span the fetch). cacheReadWrite
# itself needs no changes at all: only the fast, pure merge (_update_merge, called from here)
# ever runs under its lock now, exactly its existing synchronous contract, same as its other
# callers throughout the codebase (Profile/User/Role management) still get.
sub update_async ($opts, $cb) {
   # $CONFIG->{'docker'}{'sizes'} can disable size tracking entirely, not just defer it.
   my $path = '/containers/json?all=true' . (($CONFIG->{'docker'}{'sizes'} && $opts->{'updateSizes'}) ? '&size=true' : '');

   flog("update: requesting container list" . ($opts->{'updateSizes'} ? ' with sizes' : ' without sizes'));

   call_socket_api_async( $CONFIG->{'docker'}{'socket'}, $path, {}, sub ($result, $err) {
      try {
         unless ($result) {
            die Exception->new( 'dbg' => "Unable to execute Docker API call: $path #1", 'msg' => "Unable to retrieve container list: $err" );
         }
         unless ($result->is_success) {
            die Exception->new( 'msg' => sprintf("Unable to obtain container list via $path (response code %d, error '%s')", $result->code, $result->message) );
         }

         my $newContainersFromAPI = decode_json($result->body);

         # cacheReadWrite reads containers.json's own current content fresh, right here, right
         # before the merge - a genuine improvement over the old shape, not just incidental: the
         # Size-preservation read below is now as recent as possible, rather than read once
         # before a (possibly slow) fetch that has already happened by this point regardless.
         my $containersJSON = cacheReadWrite(
            $CONFIG->{'containersPath'},
            sub ($oldJSON) { _update_merge($newContainersFromAPI, $oldJSON) },
         );

         my $containersFile = decode_json($containersJSON);
         my $containers = $containersFile->{'containers'};

         # Assign ExpiryTimes to Reservations missing containers, and clean up old Reservations.
         Reservation->load_clean_map(keys %$containers);
      }
      catch {
         flog("update: caught exception: " . (ref($_) ? $_->dbg : $_));
      };
      $cb->() if $cb;
   } );
}

# Called when a container start event is received. Updates container state, reloads all
# data files (config, users, reservations, containers), then launches the IDE process
# inside the container if it belongs to a Dockside-managed reservation. Non-blocking throughout
# (update_async) - returns immediately, continuing via callback once the container-state update
# settles; onEvent (its only caller) never used this function's own return value, so nothing
# needed adjusting there.
sub onContainerStart ($id, $eventCount) {

   # Record the time the start event was received, before the slower update_async()/Data::load()
   # work below; used to detect stale launcher symlinks left over in the IDE volume from a
   # previous container run. Capturing this later would let a launcher written by a fast
   # entrypoint (before that work completes) look older than it really is.
   my $T1 = time();

   # This container's details might not yet have been loaded. Do this now.
   flog("onContainerStart #$eventCount: Updating docker containers without sizes before reloading reservations");
   update_async( {}, sub {
      # Reload config, reservations and containers, to access Reservation->load and %CONFIG.
      # Reload users and roles too, in case we can update owner's name and email [at later date].
      Data::load('config.json', 'users.json', 'roles.json', 'reservations.json', 'containers.json');

      my $reservations = Reservation->load({ 'containerId' => $id });
      if(!@$reservations) {
         flog("onContainerStart #$eventCount: we don't manage containerId=$id");
         return;
      }

      my $reservation = $reservations->[0]; # Safe: filtered by containerId, so at most one match.
      my $reservationId = $reservation->id;
      my $containerId = $reservation->containerId;

      flog("onContainerStart #$eventCount: we manage reservationId=$reservationId with containerId=$containerId");

      # Clear any stale pending launch entry from a previous start of the same container.
      delete $pendingLaunch{$containerId};

      # Also clear any stale %launchRecovering entry - a genuine new start event supersedes
      # whatever a previous DED restart's still-unfinished recovery sweep was tracking for this
      # containerId. Not clearing this is harmless in outcome (on_tick's own reload-and-check
      # would just find this fresh cycle's own stages and no-op once they resolve) but wasteful
      # and confusing to reason about - it would keep re-checking a reservation for an entirely
      # unrelated launch cycle until that one, coincidentally, also finished.
      delete $launchRecovering{$containerId};

      # Reset the launch:-DAG stage statuses for a fresh cycle - without this, this restart's
      # launch_advance call below (via launch_or_queue_until_launcher_ready) would see
      # launch:prep's still-persisted 'done' status from the *original* launch and skip the
      # whole cascade (including lifecycle:start, which must fire on every restart - see
      # launch_reset_stages' own comment). Exactly once here, not inside the pendingLaunch retry
      # loop below (on_tick) - those retries are for this *same* start event, and must keep
      # seeing what this reset already put in place.
      launch_reset_stages($reservation);

      try {
         launch_or_queue_until_launcher_ready($reservation, "onContainerStart #$eventCount", $T1);
      }
      catch {
         my ($msg, $dbg) = ref($_) ? ($_->msg(), $_->dbg()) : ($_,$_);
         flog("onContainerStart #$eventCount: failed to launch IDE for reservationId=$reservationId with containerId=$containerId: dbg='$dbg'; msg='$msg'");
      };
   } );
}

# Classifies a raw Docker event and dispatches to the appropriate handler.
# Returns 1 if the event is relevant (accumulated into $relevantEvents to trigger a fast
# container-state refresh), or 0 if it is not of interest and can be ignored.
sub onEvent ($event, $eventCount) {

   my $id = $event->{'Actor'}{'ID'};
   my $type = $event->{'Type'};
   my $action = $event->{'Action'};

   flog(
      sprintf("onEvent #$eventCount: received event: Type=%s, Action=%s, Actor=%s",
         $type, $action, $id
      )
   );

   if( $type eq 'network' && $action =~ /^(connect|disconnect)$/ ) {
      return 1; # Network topology changed; container port/network data may be stale.
   }

   if( $type eq 'container' && $action =~ /^(stop|create|destroy)$/ ) {
      # %pendingLaunch is keyed by the 12-char Reservation->containerId; Docker container
      # events carry the full-length Actor ID, so normalise before the lookup or the
      # cancellation misses and the daemon keeps waiting on a stopped container.
      my $cid = substr($id // '', 0, 12);
      if ($action =~ /^(stop|destroy)$/ && delete $pendingLaunch{$cid}) {
         flog("onEvent #$eventCount: cancelled pending IDE launch for $action containerId=$cid");
      }
      return 1; # Container lifecycle change; state refresh needed.
   }

   if( $type eq 'container' && $action =~ /^(start)$/ ) {
      onContainerStart($id, $eventCount);
      return 1;
   }

   return 0; # Unrecognised event type/action; no update needed.
}

# Runs the main event loop: wires up the streamed /events reader and recurring timer on
# Mojo::IOLoop's own (singleton) reactor, then blocks until the stream ends, an exception
# occurs, or a signal fires. On exit, tears down this call's own timer/stream registrations -
# necessary because Mojo::IOLoop is a singleton reused across every eventHandler() call (unlike
# the old per-call `IO::Async::Loop->new`), so a restart that didn't clean up first would
# accumulate a second, overlapping recurring timer alongside the first, each independently
# calling update_async() and servicing %pendingLaunch - the same class of bug as the rogue
# duplicate-daemon issue found elsewhere this session, just from a different cause.
sub eventHandler {
   flog("eventHandler: Starting...");

   my $eventCount = 0;
   my $lastSizesUpdateTime = 0;
   my $lastUpdateTime = 0;
   my $lastEventTime = 0;
   my $debounceQuietPeriod = 15;
   my $debounceRelevantEventsPeriod = 1;
   my $relevantEvents = 1; # force a call to Update() on startup

   my $recurringId = Mojo::IOLoop->recurring( 0.5 => sub ($loop) {
      try {
         # Updating with sizes can be slow, so only do this if:
         # - it's been more than 5s since the last event; and
         # - it's been more than 55s since the last time sizes were updated.
         if(time - $lastEventTime >= 5 && time - $lastSizesUpdateTime >= 55) {
            $lastSizesUpdateTime = time;   # set at dispatch, not completion - prevents a second
                                            # overlapping sizes fetch being kicked off before this
                                            # one (genuinely slow - see update_async's own
                                            # comment) has had a chance to land
            flog("eventHandler:tick: updating docker containers with sizes");
            update_async( { 'updateSizes' => 1 }, undef );
         }
         elsif($relevantEvents && time - $lastEventTime >= $debounceRelevantEventsPeriod) {
            flog("eventHandler:tick: updating docker containers without sizes after ${debounceRelevantEventsPeriod}s after relevant events");
            $relevantEvents = 0;
            update_async( {}, undef );
         }
         elsif(time - $lastUpdateTime >= $debounceQuietPeriod) {
            $lastUpdateTime = time;
            flog("eventHandler:tick: updating docker containers without sizes after ${debounceQuietPeriod}s");
            update_async( {}, undef );
         }
      }
      catch {
         flog("eventHandler::on_tick: caught exception: " . (ref($_) ? $_->dbg : $_));
      };

      # Start any pending IDE launches whose launcher path has appeared.
      if (%pendingLaunch) {
         try {
            for my $cid (keys %pendingLaunch) {
               my $entry = $pendingLaunch{$cid};
               next if time() < $entry->{'nextTime'};

               if (time() >= $entry->{'deadline'}) {
                  flog("eventHandler:tick: giving up on pending IDE launch for reservationId=" . $entry->{'reservationId'} . " with containerId=$cid after ${LAUNCH_READY_MAX_WAIT}s waiting for launcher '" . $entry->{'launcher'} . "'");
                  delete $pendingLaunch{$cid};
                  next;
               }

               flog("eventHandler:tick: checking pending IDE launch for reservationId=" . $entry->{'reservationId'} . " with containerId=$cid");

               Data::load('config.json', 'users.json', 'roles.json', 'reservations.json', 'containers.json');

               my $reservations = Reservation->load({ 'containerId' => $cid });
               if (!@$reservations) {
                  flog("eventHandler:tick: containerId=$cid no longer managed; cancelling pending IDE launch");
                  delete $pendingLaunch{$cid};
                  next;
               }

               my $reservation = $reservations->[0];
               my $launcher = launcher_wait_path($reservation) // $entry->{'launcher'};

               if(defined($launcher) && $launcher ne '' && !launcher_path_exists($reservation, $launcher, $entry->{'startTime'})) {
                  flog("eventHandler:tick: launcher '$launcher' still not present (or predates container start) for reservationId=" . $reservation->id . " with containerId=$cid");
                  $entry->{'launcher'} = $launcher;
                  $entry->{'nextTime'} = time() + $LAUNCH_READY_INTERVAL;
                  next;
               }

               try {
                  # See launch_or_queue_until_launcher_ready's own comment - dispatch is
                  # non-blocking and self-propagating, so "dispatched" below means the DAG was
                  # kicked off, not that launch:prep itself has actually finished yet.
                  launch_advance($reservation);
                  flog("eventHandler:tick: pending IDE launch dispatched for reservationId=" . $reservation->id . " with containerId=$cid");
                  delete $pendingLaunch{$cid};
               }
               catch {
                  my $dbg = ref($_) ? $_->dbg() : $_;
                  flog("eventHandler:tick: pending IDE launch failed after launcher became ready for reservationId=" . $reservation->id . " with containerId=$cid; cancelling pending launch: $dbg");
                  delete $pendingLaunch{$cid};
               };
            }
         }
         catch {
            flog("eventHandler::on_tick::pendingLaunch: caught exception: " . (ref($_) ? $_->dbg : $_));
         };
      }

      # Re-check any reservation restart-recovery found still genuinely in-flight after its own
      # first pass - see %launchRecovering's own comment for why this, and only this, case needs
      # per-tick polling under the async model. Self-limiting: each entry removes itself the
      # moment launch_in_flight() says there's nothing left to recover, and nothing is ever added
      # here except by the startup sweep - an empty %launchRecovering (the overwhelmingly common
      # case) costs this tick nothing beyond the truth test below.
      if (%launchRecovering) {
         try {
            for my $cid (keys %launchRecovering) {
               Data::load('config.json', 'users.json', 'roles.json', 'reservations.json', 'containers.json');
               my $reservations = Reservation->load({ 'containerId' => $cid });
               if (!@$reservations) {
                  delete $launchRecovering{$cid};
                  next;
               }

               my $reservation = $reservations->[0];
               try {
                  for my $name (@LAUNCH_STAGE_NAMES) {
                     my $state = ( $reservation->hook_status($name) // {} )->{'state'} // 'pending';
                     $reservation->hook_is_running($name) if $state eq 'running';
                  }
                  launch_advance($reservation);
               }
               catch {
                  flog("eventHandler:tick:launchRecovering: caught exception reconciling reservationId=" . $reservation->id . ": " . (ref($_) ? $_->dbg : $_));
               };

               delete $launchRecovering{$cid} unless launch_in_flight($reservation);
            }
         }
         catch {
            flog("eventHandler::on_tick::launchRecovering: caught exception: " . (ref($_) ? $_->dbg : $_));
         };
      }
   } );

   # Persistent, non-blocking streamed GET /events - see this file's own header comment for the
   # full reasoning (framing verified live, inactivity_timeout=>0 verified live, no
   # request_timeout deliberately). Plain newline-delimited JSON, one event object per line - a
   # running buffer is kept across on_read calls since a call may deliver a partial line or
   # several at once, the same discipline Util::docker_exec's own frame demuxer uses for exec
   # output.
   my $buf = '';
   call_socket_api_async(
      $CONFIG->{'docker'}{'socket'},
      '/events',
      {
         'inactivity_timeout' => 0,
         'on_read' => sub ($bytes) {
            $buf .= $bytes;
            while( (my $i = index($buf, "\n")) >= 0 ) {
               my $line = substr($buf, 0, $i);
               $buf = substr($buf, $i + 1);
               next unless length($line);

               my $event;
               eval { $event = decode_json($line); 1 } or do {
                  flog("docker events: JSON decode failed: $@ ; line=[$line]");
                  next;
               };

               $eventCount++;
               $lastEventTime = time;

               try {
                  $relevantEvents += onEvent($event, $eventCount);
               }
               catch {
                  flog("eventHandler::on_read #$eventCount: caught exception: " . (ref($_) ? $_->dbg : $_));
               };
            }
         },
      },
      sub ($result, $err) {
         # Fires exactly once, whenever the stream ends for any reason - graceful EOF,
         # connection error, or (verified live) NOT our own shutdown: Mojo::IOLoop->stop
         # interrupts the stream without ever calling this back. So reaching here always means
         # "the stream ended on its own" - stop the reactor so eventHandler returns and the
         # outer while(1) loop below reconnects, exactly as it already did for the old
         # subprocess's on_read_eof/on_closed.
         flog("docker events: stream ended" . ( $err ? " with error: $err" : ( $result ? sprintf(" (code=%d)", $result->code) : '' ) ));
         Mojo::IOLoop->stop;
      }
   );

   $STOP_EVENT_LOOP = sub { Mojo::IOLoop->stop; };

   try {
      Mojo::IOLoop->start;
   }
   catch {
      flog("eventHandler: caught exception: " . (ref($_) ? $_->dbg : $_));
      sleep 1 unless $SIGNAL_RECEIVED; # Rate-limit crash loops; skip if we're shutting down.
   };

   # Reset to no-op so a late SIGTERM arriving after loop exit doesn't call stop on a dead loop.
   $STOP_EVENT_LOOP = sub {};

   # Mojo::IOLoop is a singleton, reused across every eventHandler() call (unlike the old
   # per-call IO::Async::Loop->new) - explicitly remove this call's own recurring timer or a
   # later restart accumulates a second, overlapping one alongside it. See this sub's own
   # header comment for why that matters, not just tidiness.
   Mojo::IOLoop->remove($recurringId);

   flog("eventHandler: Ending...");
}

####################################################################################################

flog({ 'service' => 'docker-event-daemon', 'file' => "/var/log/$ENV{'USER'}/$ENV{'USER'}.log" });
flog("Starting...");

Data::load('config.json');

# Create temporary path needed for cache and log files.
if( ! -d $CONFIG->{'tmpPath'} ) {
   mkpath( [ $CONFIG->{'tmpPath'} ], 0, 0755 );
}

# Write an initial containers.json synchronously before entering the event loop.
# This ensures the Perl API server (nginx) always finds a current containers.json
# on its first request, avoiding the startup race where profiles are loaded with
# an empty network list because containers.json has not yet been written.
# update_async only ever queues its request; nothing is driving Mojo::IOLoop's reactor yet at
# this point in the script, so run it just long enough to let this one call settle - the same
# "run until done, then stop" pattern any of this file's own dispatch closures use implicitly
# once eventHandler's own Mojo::IOLoop->start is running, just applied once, standalone, here.
# There is nothing else this process could usefully be doing concurrently with this one
# call anyway (no /events stream, no launch dispatch - both start only once eventHandler runs),
# so there's no concurrency to lose by waiting for it inline.
flog("Writing initial container state synchronously...");
update_async( {}, sub { Mojo::IOLoop->stop; } );
Mojo::IOLoop->start unless Mojo::IOLoop->is_running;

# Restart-recovery: a launch stage left 'running' in hooks.status belonged to a dispatch of the
# *previous* docker-event-daemon process - that process is gone, so there is no completion
# callback left anywhere that will ever resolve it on its own (see this file's own "Launch
# dispatch orchestration" section header comment for why every *other* case resolves via its own
# callback, guaranteed, by construction). Seed from every reservation whose DAG isn't fully
# settled, self-heal any 'running' stage via the existing hook_is_running check where its exec
# has genuinely already finished, then run launch_advance to pick up wherever the DAG can now
# continue.
#
# Not necessarily settled by this one pass: hook_is_running correctly does nothing when a
# stage's exec is still genuinely running - it must not falsely resolve a live exec - but that
# leaves it exactly as orphaned as before (no callback anywhere will ever notice it finish).
# Found live, not assumed: restarting DED mid-dispatch, then confirming a stage stayed 'running'
# indefinitely, well after its real exec had actually completed. %launchRecovering (see its own
# comment) is what covers this: seeded here for anything still in-flight after this first pass,
# then on_tick re-checks it until settled. Deliberately placed only here, not inside eventHandler
# (which restarts on stream-close/crash - see the file's own banner) - this must run once per
# *process* lifetime, not once per eventHandler restart.
try {
   Data::load('config.json', 'users.json', 'roles.json', 'reservations.json', 'containers.json');
   my $allReservations = Reservation->load();
   my @inFlight = grep { launch_in_flight($_) } @$allReservations;
   flog(sprintf("Restart-recovery: %d of %d reservation(s) have a launch still in progress...", scalar @inFlight, scalar @$allReservations));
   for my $reservation (@inFlight) {
      try {
         for my $name (@LAUNCH_STAGE_NAMES) {
            my $state = ( $reservation->hook_status($name) // {} )->{'state'} // 'pending';
            $reservation->hook_is_running($name) if $state eq 'running';   # self-heals in place if dead
         }
         launch_advance($reservation);
         $launchRecovering{ $reservation->containerId } = 1 if launch_in_flight($reservation);
      }
      catch {
         flog("Restart-recovery: caught exception reconciling reservationId=" . $reservation->id . ": " . (ref($_) ? $_->dbg : $_));
      };
   }
   flog(sprintf("Restart-recovery: %d reservation(s) still in flight after the first pass; on_tick will keep re-checking them", scalar keys %launchRecovering)) if %launchRecovering;
}
catch {
   flog("Restart-recovery sweep failed (non-fatal): " . (ref($_) ? $_->dbg : $_));
};

# Restart eventHandler if the 'docker events' stream closes unexpectedly (e.g. Docker restart).
while(1) {
   eventHandler();

   last if $SIGNAL_RECEIVED;
   sleep 1;
}
flog("Exiting.");

1;
