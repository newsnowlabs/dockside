#!/usr/bin/perl

# docker-event-daemon
#
# A daemon that keeps Dockside's container state file (containers.json) in sync with the live
# Docker engine, bridging Docker's runtime state to Dockside's own data layer so the application
# always has an up-to-date view of running containers.
#
# Event loop (eventHandler):
# - A persistent, non-blocking streamed GET /events (Mojo::IOLoop, via Util::call_socket_api_async)
#   - not a spawned `docker events` subprocess. Maps directly onto `docker events --format
#   "{{ json . }}"`'s own output: newline-delimited JSON, one event object per line, verified
#   live against this environment's own daemon (see
#   docs/plans/lifecycle-hooks-review-followup.md item F3) - no demuxing needed here, unlike exec
#   output.
# - Runs a 0.5s recurring timer (Mojo::IOLoop->recurring) alongside the event stream, on the same
#   reactor - verified live that a long-held-open stream and a recurring timer coexist correctly
#   without blocking each other.
# - The /events call's own inactivity_timeout is disabled (0) deliberately: this stream is meant
#   to run forever, and Docker's own quiet periods routinely exceed Mojo's 20s default (verified
#   live: idle for 22s with inactivity_timeout=>0 stayed open, no spurious error). No
#   request_timeout either, for the same reason - that bounds the whole call regardless of
#   activity, which is wrong for a perpetual stream.
#
# Debounced updates (timer tick):
# Three tiers of update frequency:
# 1. With sizes    - every ~55s, but only when no events have arrived for 5+ seconds (slow, so deferred).
# 2. After events  - within 1s of a relevant event (fast refresh).
# 3. Heartbeat     - every 15s regardless (keeps state fresh even when idle).
#
# Event handling (onEvent):
# Listens for specific Docker event types:
# - network connect/disconnect     -> triggers a container update.
# - container stop/create/destroy  -> triggers a container update.
# - container start                -> triggers onContainerStart, which also launches the IDE
#                                     process inside the container via $reservation->exec().
#
# Container state update (_update / update):
# - Calls the Docker API (/containers/json) via a Unix socket - deliberately kept blocking (not
#   migrated to the non-blocking primitive above): infrequent and fast in practice, not a real
#   problem in this daemon's own history; migrating it is about reactor-design unity, not a need
#   that's actually been hit, so it's out of scope for now (see item F3's own scope decision).
# - Rebuilds the container map: short ID, name, status, image, ports, volume mounts
#   (including the IDE volume path and host-data volume path).
# - Preserves the last-known Size value when not requesting a fresh size calculation (avoiding slow calls).
# - Writes results to containers.json via cacheReadWrite.
# - Triggers Reservation->load_clean_map to assign expiry times to reservations
#   whose containers have disappeared.
#
# Lifecycle:
# - Runs in an outer while(1) loop: if eventHandler crashes or the /events stream closes (Docker
#   restart, connection error, etc.), it restarts automatically after 1 second.
# - Handles SIGTERM/SIGINT/SIGQUIT cleanly: sets a flag and stops the Mojo::IOLoop reactor -
#   verified live that Mojo::IOLoop->stop cleanly interrupts an in-flight streamed request with
#   no hang and no completion callback firing, so there is no subprocess-style two-stage
#   SIGTERM-then-SIGKILL shutdown to do here any more; the process just exits.

use v5.36;

use JSON;

use Try::Tiny;
use File::Path;
use Time::HiRes qw(time);

use Mojo::IOLoop;

use Util qw(cacheReadWrite flog call_socket_api call_socket_api_async docker_container_path_exists);
use Exception;
use Data qw($CONFIG);
use Reservation;
use Containers;
use User;

# mountIDE:false Dockside devtainers populate their own /opt/dockside volume
# during entrypoint startup. Defer IDE launch until the configured launcher path
# exists instead of retrying docker exec failures.
my $LAUNCH_READY_MAX_WAIT = 60; # seconds
my $LAUNCH_READY_INTERVAL = 1;  # seconds between Docker API readiness checks

my %pendingLaunch;  # containerId => { deadline => epoch, nextTime => epoch, launcher => path, reservationId => id }

my $SIGNAL_RECEIVED = 0;
my $STOP_EVENT_LOOP = sub { };

$SIG{'INT'} = $SIG{'QUIT'} = $SIG{'TERM'} = sub {
   # This will stop the Mojo::IOLoop reactor - see eventHandler's own comment on why that's a
   # clean, sufficient shutdown now (verified live), with no subprocess to separately terminate.
   flog("eventHandler: Received SIGTERM; preparing to exit.");
   $SIGNAL_RECEIVED = 1;
   $STOP_EVENT_LOOP->();
};

sub launcher_wait_path ($reservation) {
   return undef if $reservation->profileObject->should_mount_ide;

   return $reservation->ide_command_launcher();
}

# Returns true if the launcher exists inside the container AND its mtime is >= $since
# (meaning it was written during the current container run, not left over from a previous one).
# $since is undef when no staleness check is needed (e.g. first-ever launch with no prior volume).
sub launcher_path_exists ($reservation, $launcher, $since = undef) {
   my ($exists, $mtime) = docker_container_path_exists(
      $CONFIG->{'docker'}{'socket'},
      $reservation->containerId,
      $launcher
   );
   return 0 unless $exists;
   # $mtime is whole seconds (Docker's stat has no sub-second precision by the time it's
   # parsed); $since may carry a Time::HiRes fractional part, so floor it before comparing
   # or a launcher written in the same second as $since is wrongly seen as predating it.
   return 0 if defined($since) && defined($mtime) && $mtime < int($since);
   return 1;
}

sub queue_pending_launch ($reservation, $context, $launcher, $since) {
   my $containerId = $reservation->containerId;

   # The container is running but the IDE is not yet launched. Until it is,
   # route UI IDE links according to the requested IDE, not any previous value. Narrow store -
   # see Reservation::store_fields' own comment - since this reservation may concurrently be
   # written by other, unrelated fields.
   $reservation->data('runningIDE', $reservation->meta('IDE'));
   $reservation->store_fields( { 'data' => { 'runningIDE' => $reservation->data('runningIDE') } } );

   $pendingLaunch{$containerId} = {
      deadline      => time() + $LAUNCH_READY_MAX_WAIT,
      nextTime      => time() + $LAUNCH_READY_INTERVAL,
      launcher      => $launcher,
      reservationId => $reservation->id,
      startTime     => $since,
   };

   flog("$context: delaying IDE launch for reservationId=" . $reservation->id . " with containerId=$containerId: launcher '$launcher' is not present yet (or predates container start)");
}

sub launch_or_queue_until_launcher_ready ($reservation, $context, $since) {
   my $launcher = launcher_wait_path($reservation);

   if(defined($launcher) && $launcher ne '' && !launcher_path_exists($reservation, $launcher, $since)) {
      queue_pending_launch($reservation, $context, $launcher, $since);
      return undef;
   }

   return $reservation->exec();
}

# Updates the container state by retrieving the current container list
# from the Docker API and merging it with the existing container data.
#
# Parameters:
# - $oldJSON: A JSON string representing the previous state of the containers.
# - $opts: A hash reference containing options, specifically
#   - 'updateSizes' => undef|1
#     whether to include container sizes in the API request.
#
# Returns:
# A JSON string representing the updated container state, including
# both the existing and newly retrieved container data.
#
# Throws:
# Exception if unable to retrieve the container list from the Docker API
# or if the API response is not successful.

sub _update ($oldJSON, $opts) {
   # $CONFIG->{'docker'}{'sizes'} can disable size tracking entirely, not just defer it.
   my $path = '/containers/json?all=true' . (($CONFIG->{'docker'}{'sizes'} && $opts->{'updateSizes'}) ? '&size=true' : '');

   flog("update: requesting container list" . ($opts->{'updateSizes'} ? ' with sizes' : ' without sizes'));

   my $result = call_socket_api(
      $CONFIG->{'docker'}{'socket'},
      $path
   );

   unless($result) {
      die Exception->new( 'dbg' => "Unable to execute Docker API call: $path #1", 'msg' => "Unable to retrieve container list" );
   }

   if(!$result->is_success) {
      die Exception->new( 'msg' => sprintf("Unable to obtain container list via $path (response code %d, error '%s')", $result->code, $result->message) );
   }

   my $newContainersFromAPI;
   my $oldContainers;
   try {
      $oldContainers = $oldJSON ? decode_json($oldJSON)->{'containers'} : {};
      $newContainersFromAPI = decode_json($result->body);
   }
   catch {
      $oldContainers = {};
   };

   my $idePath = $CONFIG->{'ide'}{'path'};
   my $hostDataPath = $CONFIG->{'ssh'}{'path'};

   my $newContainers;
   foreach my $c (@$newContainersFromAPI) {

      my $ID = substr($c->{'Id'}, 0, 12); # Truncate to Docker's standard short ID length.

      # For each mount point of interest, produce ['volume', $name] or ['bind', $source].
      my ($ideVolume) = map { $_->{'Type'} eq 'volume' ? ['volume', $_->{'Name'}] : ['bind', $_->{'Source'}] } grep { $_->{'Destination'} eq $idePath } @{$c->{'Mounts'}};
      my ($hostDataVolume) = map { $_->{'Type'} eq 'volume' ? ['volume', $_->{'Name'}] : ['bind', $_->{'Source'}] } grep { $_->{'Destination'} eq $hostDataPath } @{$c->{'Mounts'}};

      $newContainers->{$ID}{'docker'} = {
         'ID' => $ID, # Short ID (for now)
         'Names' => substr($c->{'Names'}[0], 1), # Skip leading '/'
         'CreatedAt' => $c->{'Created'}, # Was string; now unixtime
         'Status' => $c->{'Status'}, # String
         'Image' => $c->{'Image'}, # String
         'ImageId' => substr( substr($c->{'ImageID'}, 7), 0, 12), # Strip 'sha256:' prefix (7 chars), then truncate to short ID.
         'Size' => $c->{'SizeRw'},
         'Networks' => join(',', sort keys %{$c->{'NetworkSettings'}{'Networks'}})
      };

      # HashRef keyed on internal port looking up host port.
      # This is only needed when $CONFIG->{'gateway'}{'enabled'} is true (and this is deprecated)
      my $ports = { map { $_->{'PrivatePort'} => $_->{'PublicPort'} } @{$c->{'Ports'}} };

      $newContainers->{$ID}{'inspect'} = { 
         'Networks' => $c->{'NetworkSettings'}{'Networks'},
         'Ports' => $ports,
         'ideVolume' => $ideVolume,
         'hostDataVolume' => $hostDataVolume
      };

      # Copy the container Size from the oldContainer record if we haven't requested the Size on this run.
      if( $oldContainers && $oldContainers->{$ID} && $oldContainers->{$ID}{'docker'}{'Size'} ) {
         if( !$newContainers->{$ID}{'docker'}{'Size'} ) {
            $newContainers->{$ID}{'docker'}{'Size'} = $oldContainers->{$ID}{'docker'}{'Size'};
         }
      }

   }

   my $newContainersFile = { 'version' => Containers::CURRENT_VERSION, 'containers' => $newContainers };

   return encode_json($newContainersFile);
}

# Updates the container state by retrieving the current container list
# from the Docker API and merging it with the existing container data.
#
# Parameters:
# - $opts: A hash reference containing options, specifically
#   - 'updateSizes' => undef|1
#     whether to include container sizes in the API request.
#
# Returns:
# A JSON string representing the updated container state, including
# both the existing and newly retrieved container data.
#
# Throws:
# Exception if unable to retrieve the container list from the Docker API
# or if the API response is not successful.
sub update ($opts = {}) {

   # cacheReadWrite handles the atomic read-modify-write cycle: it reads the existing
   # file, passes its content as $oldJSON to _update, then writes the returned JSON back.
   my $containersJSON = cacheReadWrite(
      $CONFIG->{'containersPath'},
      \&_update,
      $opts
   );

   try {
      my $containersFile = decode_json($containersJSON);
      my $containers = $containersFile->{'containers'};

      # Assign ExpiryTimes to Reservations missing containers, and clean up old Reservations.
      Reservation->load_clean_map(keys %$containers);
   }
   catch {
      flog("update: caught exception: " . (ref($_) ? $_->dbg : $_));
   };
}

# Called when a container start event is received. Updates container state, reloads all
# data files (config, users, reservations, containers), then launches the IDE process
# inside the container if it belongs to a Dockside-managed reservation.
sub onContainerStart ($id, $eventCount) {

   # Record the time the start event was received, before the slower update()/Data::load()
   # calls below; used to detect stale launcher symlinks left over in the IDE volume from a
   # previous container run. Capturing this later would let a launcher written by a fast
   # entrypoint (before update()/Data::load() complete) look older than it really is.
   my $T1 = time();

   # This container's details might not yet have been loaded. Do this now.
   flog("onContainerStart #$eventCount: Updating docker containers without sizes before reloading reservations");
   update();

   # Reload config, reservations and containers, to access Reservation->load and %CONFIG.
   # Reload users and roles too, in case we can update owner's name and email [at later date].
   Data::load('config.json', 'users.json', 'roles.json', 'reservations.json', 'containers.json');

   my $reservations = Reservation->load({ 'containerId' => $id });
   if(!@$reservations) {
      flog("onContainerStart #$eventCount: we don't manage containerId=$id");
      return undef;
   }

   my $reservation = $reservations->[0]; # Safe: filtered by containerId, so at most one match.
   my $reservationId = $reservation->id;
   my $containerId = $reservation->containerId;

   flog("onContainerStart #$eventCount: we manage reservationId=$reservationId with containerId=$containerId");

   # Clear any stale pending launch entry from a previous start of the same container.
   delete $pendingLaunch{$containerId};

   my $launched;
   try {
      $launched = launch_or_queue_until_launcher_ready($reservation, "onContainerStart #$eventCount", $T1);
   }
   catch {
      my ($msg, $dbg) = ref($_) ? ($_->msg(), $_->dbg()) : ($_,$_);
      flog("onContainerStart #$eventCount: failed to launch IDE for reservationId=$reservationId with containerId=$containerId: dbg='$dbg'; msg='$msg'");
   };

   return $launched ? 1 : undef;
}

# Classifies a raw Docker event and dispatches to the appropriate handler.
# Returns 1 if the event is relevant (accumulated into $relevantEvents to trigger a fast
# container-state refresh), or 0 if it is not of interest and can be ignored.
sub onEvent ($event, $eventCount) {

   my $id = $event->{'Actor'}{'ID'};
   my $type = $event->{'Type'};
   my $action = $event->{'Action'};

   flog(
      sprintf("onEvent #$eventCount: received event: Type=%s, Action=%s, Actor=%s",
         $type, $action, $id
      )
   );

   if( $type eq 'network' && $action =~ /^(connect|disconnect)$/ ) {
      return 1; # Network topology changed; container port/network data may be stale.
   }

   if( $type eq 'container' && $action =~ /^(stop|create|destroy)$/ ) {
      # %pendingLaunch is keyed by the 12-char Reservation->containerId; Docker container
      # events carry the full-length Actor ID, so normalise before the lookup or the
      # cancellation misses and the daemon keeps waiting on a stopped container.
      my $cid = substr($id // '', 0, 12);
      if ($action =~ /^(stop|destroy)$/ && delete $pendingLaunch{$cid}) {
         flog("onEvent #$eventCount: cancelled pending IDE launch for $action containerId=$cid");
      }
      return 1; # Container lifecycle change; state refresh needed.
   }

   if( $type eq 'container' && $action =~ /^(start)$/ ) {
      onContainerStart($id, $eventCount);
      return 1;
   }

   return 0; # Unrecognised event type/action; no update needed.
}

# Runs the main event loop: wires up the streamed /events reader and recurring timer on
# Mojo::IOLoop's own (singleton) reactor, then blocks until the stream ends, an exception
# occurs, or a signal fires. On exit, tears down this call's own timer/stream registrations -
# necessary because Mojo::IOLoop is a singleton reused across every eventHandler() call (unlike
# the old per-call `IO::Async::Loop->new`), so a restart that didn't clean up first would
# accumulate a second, overlapping recurring timer alongside the first, each independently
# calling update() and servicing %pendingLaunch - the same class of bug as the rogue
# duplicate-daemon issue found elsewhere this session, just from a different cause.
sub eventHandler {
   flog("eventHandler: Starting...");

   my $eventCount = 0;
   my $lastSizesUpdateTime = 0;
   my $lastUpdateTime = 0;
   my $lastEventTime = 0;
   my $debounceQuietPeriod = 15;
   my $debounceRelevantEventsPeriod = 1;
   my $relevantEvents = 1; # force a call to Update() on startup

   my $recurringId = Mojo::IOLoop->recurring( 0.5 => sub ($loop) {
      try {
         # Updating with sizes can be slow, so only do this if:
         # - it's been more than 5s since the last event; and
         # - it's been more than 55s since the last time sizes were updated.
         if(time - $lastEventTime >= 5 && time - $lastSizesUpdateTime >= 55) {
            $lastSizesUpdateTime = time;
            flog("eventHandler:tick: updating docker containers with sizes");
            update({ 'updateSizes' => 1 });
         }
         elsif($relevantEvents && time - $lastEventTime >= $debounceRelevantEventsPeriod) {
            flog("eventHandler:tick: updating docker containers without sizes after ${debounceRelevantEventsPeriod}s after relevant events");
            $relevantEvents = 0;
            update();
         }
         elsif(time - $lastUpdateTime >= $debounceQuietPeriod) {
            $lastUpdateTime = time;
            flog("eventHandler:tick: updating docker containers without sizes after ${debounceQuietPeriod}s");
            update();
         }
      }
      catch {
         flog("eventHandler::on_tick: caught exception: " . (ref($_) ? $_->dbg : $_));
      };

      # Start any pending IDE launches whose launcher path has appeared.
      if (%pendingLaunch) {
         try {
            for my $cid (keys %pendingLaunch) {
               my $entry = $pendingLaunch{$cid};
               next if time() < $entry->{'nextTime'};

               if (time() >= $entry->{'deadline'}) {
                  flog("eventHandler:tick: giving up on pending IDE launch for reservationId=" . $entry->{'reservationId'} . " with containerId=$cid after ${LAUNCH_READY_MAX_WAIT}s waiting for launcher '" . $entry->{'launcher'} . "'");
                  delete $pendingLaunch{$cid};
                  next;
               }

               flog("eventHandler:tick: checking pending IDE launch for reservationId=" . $entry->{'reservationId'} . " with containerId=$cid");

               Data::load('config.json', 'users.json', 'roles.json', 'reservations.json', 'containers.json');

               my $reservations = Reservation->load({ 'containerId' => $cid });
               if (!@$reservations) {
                  flog("eventHandler:tick: containerId=$cid no longer managed; cancelling pending IDE launch");
                  delete $pendingLaunch{$cid};
                  next;
               }

               my $reservation = $reservations->[0];
               my $launcher = launcher_wait_path($reservation) // $entry->{'launcher'};

               if(defined($launcher) && $launcher ne '' && !launcher_path_exists($reservation, $launcher, $entry->{'startTime'})) {
                  flog("eventHandler:tick: launcher '$launcher' still not present (or predates container start) for reservationId=" . $reservation->id . " with containerId=$cid");
                  $entry->{'launcher'} = $launcher;
                  $entry->{'nextTime'} = time() + $LAUNCH_READY_INTERVAL;
                  next;
               }

               try {
                  $reservation->exec();
                  flog("eventHandler:tick: pending IDE launch succeeded for reservationId=" . $reservation->id . " with containerId=$cid");
                  delete $pendingLaunch{$cid};
               }
               catch {
                  my $dbg = ref($_) ? $_->dbg() : $_;
                  flog("eventHandler:tick: pending IDE launch failed after launcher became ready for reservationId=" . $reservation->id . " with containerId=$cid; cancelling pending launch: $dbg");
                  delete $pendingLaunch{$cid};
               };
            }
         }
         catch {
            flog("eventHandler::on_tick::pendingLaunch: caught exception: " . (ref($_) ? $_->dbg : $_));
         };
      }
   } );

   # Persistent, non-blocking streamed GET /events - see this file's own header comment for the
   # full reasoning (framing verified live, inactivity_timeout=>0 verified live, no
   # request_timeout deliberately). Plain newline-delimited JSON, one event object per line - a
   # running buffer is kept across on_read calls since a call may deliver a partial line or
   # several at once, the same discipline Util::docker_exec's own frame demuxer uses for exec
   # output.
   my $buf = '';
   call_socket_api_async(
      $CONFIG->{'docker'}{'socket'},
      '/events',
      {
         'inactivity_timeout' => 0,
         'on_read' => sub ($bytes) {
            $buf .= $bytes;
            while( (my $i = index($buf, "\n")) >= 0 ) {
               my $line = substr($buf, 0, $i);
               $buf = substr($buf, $i + 1);
               next unless length($line);

               my $event;
               eval { $event = decode_json($line); 1 } or do {
                  flog("docker events: JSON decode failed: $@ ; line=[$line]");
                  next;
               };

               $eventCount++;
               $lastEventTime = time;

               try {
                  $relevantEvents += onEvent($event, $eventCount);
               }
               catch {
                  flog("eventHandler::on_read #$eventCount: caught exception: " . (ref($_) ? $_->dbg : $_));
               };
            }
         },
      },
      sub ($result, $err) {
         # Fires exactly once, whenever the stream ends for any reason - graceful EOF,
         # connection error, or (verified live) NOT our own shutdown: Mojo::IOLoop->stop
         # interrupts the stream without ever calling this back. So reaching here always means
         # "the stream ended on its own" - stop the reactor so eventHandler returns and the
         # outer while(1) loop below reconnects, exactly as it already did for the old
         # subprocess's on_read_eof/on_closed.
         flog("docker events: stream ended" . ( $err ? " with error: $err" : ( $result ? sprintf(" (code=%d)", $result->code) : '' ) ));
         Mojo::IOLoop->stop;
      }
   );

   $STOP_EVENT_LOOP = sub { Mojo::IOLoop->stop; };

   try {
      Mojo::IOLoop->start;
   }
   catch {
      flog("eventHandler: caught exception: " . (ref($_) ? $_->dbg : $_));
      sleep 1 unless $SIGNAL_RECEIVED; # Rate-limit crash loops; skip if we're shutting down.
   };

   # Reset to no-op so a late SIGTERM arriving after loop exit doesn't call stop on a dead loop.
   $STOP_EVENT_LOOP = sub {};

   # Mojo::IOLoop is a singleton, reused across every eventHandler() call (unlike the old
   # per-call IO::Async::Loop->new) - explicitly remove this call's own recurring timer or a
   # later restart accumulates a second, overlapping one alongside it. See this sub's own
   # header comment for why that matters, not just tidiness.
   Mojo::IOLoop->remove($recurringId);

   flog("eventHandler: Ending...");
}

####################################################################################################

flog({ 'service' => 'docker-event-daemon', 'file' => "/var/log/$ENV{'USER'}/$ENV{'USER'}.log" });
flog("Starting...");

Data::load('config.json');

# Create temporary path needed for cache and log files.
if( ! -d $CONFIG->{'tmpPath'} ) {
   mkpath( [ $CONFIG->{'tmpPath'} ], 0, 0755 );
}

# Write an initial containers.json synchronously before entering the event loop.
# This ensures the Perl API server (nginx) always finds a current containers.json
# on its first request, avoiding the startup race where profiles are loaded with
# an empty network list because containers.json has not yet been written.
flog("Writing initial container state synchronously...");
try { update() } catch { flog("Initial update failed (non-fatal): " . (ref($_) ? $_->dbg : $_)) };

# Restart eventHandler if the 'docker events' stream closes unexpectedly (e.g. Docker restart).
while(1) {
   eventHandler();

   last if $SIGNAL_RECEIVED;
   sleep 1;
}
flog("Exiting.");

1;
