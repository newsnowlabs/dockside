{
   "version": 2,
   "name": "Dockside (IDE from image)",
   "description": "Dockside (with IDE from image)",
   "active": true,
   "mountIDE": false, // Don't mount the production (outer Dockside) IDE
   "routers": [
      {
         "name": "dockside",
         "prefixes": [ "www" ],
         "domains": [ "*" ],
         "auth": [ "developer", "owner", "viewer", "user", "containerCookie", "public" ],

         // This normally implies public port 443
         "https": { "protocol": "https", "port": 443 }
      },
      {
         "name": "passthru",
         "prefixes": ["**"],
         "domains": ["*"],
         "type": "passthru",

         // This normally implies public port 80.
         // protocol will default to the public protocol if unspecified.
         "http": { "protocol": "http", "port": 80 },

         // This normally implies public port 443
         "https": { "protocol": "https", "port": 443 }
      }
   ],

   "networks": [ "*" ],
   "runtimes": [ "*" ],
   "images": [ "newsnowlabs/dockside:development", "newsnowlabs/dockside:latest", "newsnowlabs/dockside:prerelease", "newsnowlabs/dockside:test" ],

   "unixusers": [ "dockside" ],

   // Lets a devtainer launched from this profile switch to a different branch or
   // PR of Dockside's own repo (already baked into the image at
   // /home/dockside/dockside) and actually run it: the hook below re-checks-out
   // the repo, rebuilds the client and restarts Dockside's own services. See
   // docs/extensions/lifecycle-hooks.md.
   "hooks": {
      "launch": "/home/dockside/dockside/app/scripts/hooks/dockside-self-update.sh"
   },
   "options": [
      {
         "name": "branch",
         "label": "Branch",
         "type": "text",
         "default": "",
         "placeholder": "e.g. main (leave blank to just pull the current branch)"
      },
      {
         "name": "pr",
         "label": "Pull Request #",
         "type": "text",
         "default": "",
         "placeholder": "e.g. 42 (overrides branch if set)"
      }
   ],

   "imagePathsFilter" : [],

   "mounts": {

      // Use this to identify paths in your containers that will contain ephemeral data that will be lost
      // when the container is stopped, and which will not be duplicated in a clone operation.
      "tmpfs": [

         // {ideUser} will be substituted at launch-time with the user that
         // the IDE will be launched as (as per the "users" option above).
         { "dst": "/home/dockside/.vscode", "tmpfs-size": "150M" },
         { "dst": "/home/dockside/.ssh", "tmpfs-size": "1M" },

         // These are good for most Linux distributions
         { "dst": "/tmp", "tmpfs-size": "512M" },
         { "dst": "/var/tmp", "tmpfs-size": "128M" },
         { "dst": "/run", "tmpfs-size": "64M" }
      ],

      // Use this to bind-mount shared development resources, or shared application data, from the host
      // into your containers, and which will not be duplicated in a clone operation.
      "bind": [ 
         { "src": "/var/run/docker.sock", "dst": "/var/run/docker.sock" }
      ],

      "volume": [
      ]
   },

   "security": {
      "apparmor": "unconfined"
   },

   "dockerArgs": ["--memory=2G", "--pids-limit=4000"],
   "runDockerInit": false,
   "command": ["--ssl-selfsigned", "--ssl-zone", "{container.hostname}", "--passwd-stdout"]
}
