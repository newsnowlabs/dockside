{
   "version": 2,
   "name": "Hugo site",
   "active": true,
   "routers": [
      {
         "name": "www",
         "prefixes": [
            "www"
         ],
         "domains": [
            "*"
         ],
         "https": {
            "protocol": "http",
            "port": 1313
         },
         "auth": [
            "developer",
            "owner",
            "viewer",
            "user",
            "containerCookie",
            "public"
         ]
      }
   ],
   "networks": [
      "*"
   ],
   "images": [
      "ghcr.io/newsnowlabs/dockside/example/images/hugo:latest"
   ],
   "unixusers": [
      "dockside"
   ],
   "mounts": {
      "tmpfs": [
         {
            "dst": "/home/{ideUser}/.ssh",
            "tmpfs-size": "1M"
         }
      ]
   },
   "security": {
      "apparmor": "unconfined"
   },
   "command": [
      "https://www-{container.hostname}"
   ],
   "dockerArgs": [
      "--memory=1G",
      "--pids-limit=4000",
      "--cpus=1"
   ]
}
